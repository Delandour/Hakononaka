
default food_h_points = 0
default food_p_points = 0
default food_j_points = 0
default current_food_choice = None  # 新增状态变量
default satiety = 70  # 新增饱食度变量
default satiety_max = 100  # 饱食度最大值
default fed = False  # 新增喂食状态标志

# 新增"随机标签列表（存储除首次豪华外的标签）
default h_random_labels = []  # 豪华食物随机列表（food_h2~h7）
default p_random_labels = []  # 普通食物随机列表（food_p1~p7）
default j_random_labels = []  # 简陋食物随机列表（food_j1~j7）

# 预定义所有可能的跳转逻辑
init python:
    import random  # 导入随机模块
    
    # 生成豪华食物随机列表（排除首次的food_h1）
    def generate_h_random():
        if affection < 60:
            return random.sample(["food_h2", "food_h3", "food_h4", "food_h5", "food_h6"], 5)
        else:
            return random.sample(["food_h2", "food_h3", "food_h4", "food_h5", "food_h6", "food_h7"], 6)
    
    # 生成普通食物随机列表
    def generate_p_random():
        if affection < 60:
            return random.sample(["food_p1", "food_p2", "food_p3", "food_p4", "food_p5"], 5)
        else:
            return random.sample(["food_p1", "food_p2", "food_p3", "food_p4", "food_p5", "food_p6"], 6)
    
    # 生成简陋食物随机列表
    def generate_j_random():
        return random.sample(["food_j1", "food_j2", "food_j3", "food_j4", "food_j5"], 5)
    
    # 修改标签获取函数（核心逻辑）
    def get_food_label(choice_type, points):
        if choice_type == "h":  # 豪华食物
            if points == 1:  # 第一次豪华喂食"固定返回food_h1
                return "food_h1"
            else:  # 后续豪华喂食"从随机列表中取
                global h_random_labels
                # 若列表为空，重新生成随机顺序
                if not h_random_labels:
                    h_random_labels = generate_h_random()
                # 取列表第一个元素并删除（避免重复）
                return h_random_labels.pop(0)
        
        elif choice_type == "p":  # 普通食物
            global p_random_labels
            if not p_random_labels:
                p_random_labels = generate_p_random()
            return p_random_labels.pop(0)
        
        elif choice_type == "j":  # 简陋食物
            global j_random_labels
            if not j_random_labels:
                j_random_labels = generate_j_random()
            return j_random_labels.pop(0)
        
        return "default_feed"

label daily_feed:

    $ Y_room = False
    # 新增"检测异常状态并修复
    if current_food_choice is not None:
        $ current_food_choice = None  # 强制清空异常值

    if health <= 40:
        menu:
            sy"是否给夜神月喂药恢复健康？"
            "确定喂药":
                $ health = min(health_max, health + 30)
                "夜神月皱着眉把药吞了下去。"
                "好好休息就会恢复健康吧。"
                sy"健康值恢复30点。"
                
                $ fed = True
                jump after_feed
            "取消喂药":
                "你不想做没有意义的事情，这是你的选择。"
                $ Y_room = True
                jump action_menu      

    menu:
        "请选择食物的档次："
        "豪华":
            $ new_satiety = satiety + 30

            if new_satiety <= satiety_max:
                $ satiety = new_satiety
                $ food_h_points += 1
                $ current_food_choice = "h"
                $ fed = True  # 标记成功喂食
                if unlock_the_handcuffs:
                    $ affection = min(affection + 3, 75)
                else:
                    $ affection = min(affection + 3, 70)
                $ stress = max(0, stress - 5)                
                call choose_food from _call_choose_food
            else:
                "月对拿着食物的L露出无奈的表情。"
                Y "我现在吃不下这么多。"
                $ fed = False  # 标记喂食失败
                $ Y_room = True
                jump action_menu
        "普通":
            $ persistent.unlock_feed_1 = True
            $ new_satiety = satiety + 25
            if new_satiety <= satiety_max:
                $ satiety = new_satiety
                $ food_p_points += 1
                $ current_food_choice = "p"
                $ fed = True
                call choose_food from _call_choose_food_1
            else:
                "月对拿着食物的L露出无奈的表情。"
                Y "我现在吃不下这么多。"
                $ fed = False
                $ Y_room = True
                jump action_menu
        "简陋":
            $ persistent.unlock_feed_1 = True
            $ new_satiety = satiety + 15
            if new_satiety <= satiety_max:
                $ satiety = new_satiety
                $ food_j_points += 1
                $ current_food_choice = "j"
                $ fed = True
                $ affection = max(0, affection - 5)
                $ stress = min(stress + 5 , 100)                 
                call choose_food from _call_choose_food_2
            else:
                "月对拿着食物的L露出无奈的表情。"
                Y "我现在吃不下这么多。"
                $ fed = False
                $ Y_room = True
                jump action_menu

          

label choose_food:
    $ choice_type = current_food_choice
    $ points = globals()[f"food_{choice_type}_points"]
    $ target_label = get_food_label(choice_type, points)
    jump expression target_label


screen satiety_notify(current, max_val, action_points):
    # 弹窗模式"阻止点击其他区域，必须点击确认才能关闭
    modal True
    zorder 200  # 确保弹窗在最上层显示
         
    vbox:
        xalign 0.5
        yalign 0.5
        spacing 30
        
        # 弹窗内容框
        frame:
            xsize 800
            ysize 200
            background "#a1a1a1d9"  # 半透明背景
            padding (10, 10)
            vbox:
                xalign 0.5
                yalign 0.2
                spacing 20
                # 标题
                text _("喂食完毕"): 
                    xalign 0.5

                hbox:
                    text _("饱食度："):
                        min_width 80  # 固定标签宽度，对齐更整齐
                        yalign 0.5
                    bar:
                        value AnimatedValue(satiety, satiety_max, 1.0)  # 动画过渡效果
                        xmaximum 200  # 进度条宽度
                        ysize 26      # 进度条高度
                        yalign 0.5
                    text " [satiety]/[satiety_max] ([get_status_description(satiety, satiety_descriptions)])":
                        yalign 0.5
    
        # 确认按钮
        textbutton _("确认"):
            action Return()  
            xalign 0.5
            ypos -90
            


