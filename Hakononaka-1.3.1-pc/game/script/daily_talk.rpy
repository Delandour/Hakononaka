default talk_points = 0  # 对话次数计数器（全局）
default dialog_points = 0 #当天对话次数（每日重置）
default random_talks = [] # 存储 talk2~talk7 的随机顺序

# 预定义对话次数到标签的映射
init python:
    import random

label daily_talk:
    $ Y_room = False
    if health <= 40:
        "夜神月看起来身体不适，需要尽快喂食药物。"
        menu:
            sy"需要返回行动菜单吗？"
            "返回":
                sy"不消耗行动点数，你还剩下[action_points]点行动点数。"
                $ Y_room = True
                jump action_menu

            "继续行动":
                if dialog_points >= 1:
                    "夜神月今天已经不想和你聊天了。"
                    "去做点别的事情吧。"
                    sy"你还剩下[action_points]点行动点数。"
                    $ Y_room = True
                    jump action_menu

                $ talk_points += 1  # 总对话次数+1
                $ dialog_points += 1 
            
                jump handle_talk


    if dialog_points >= 1:
        "夜神月今天已经不想和你聊天了。"
        "去做点别的事情吧。"
        sy"你还剩下[action_points]点行动点数。"
        $ Y_room = True
        jump action_menu

    $ talk_points += 1  # 总对话次数+1
    $ dialog_points += 1 
    jump handle_talk
    
label handle_talk:

    if talk_points == 1:
        jump talk1
    else:
        if not random_talks:
            # 根据好感度选择不同的对话池
            if affection >= 60:
                # 好感度>=60：随机选择talk2~4
                $ random_talks = random.sample(["talk2", "talk5", "talk6", "talk7", "talk8", "talk9"], 6)
            else:
                # 好感度<60：随机选择talk5~7
                $ random_talks = random.sample(["talk2", "talk3", "talk4", "talk5", "talk6", "talk7", "talk9"], 7)

        $ current_talk = random_talks.pop(0)
        jump expression current_talk        

label talk1:

