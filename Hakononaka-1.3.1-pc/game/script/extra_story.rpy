default true_end_point = 0

label extra_story:
    $ true_end_point = 0
    scene black with dissolve
    if persistent.unlock_happy_end:
        $ true_end_point += 1
    if persistent.unlock_bad_end:
        $ true_end_point += 1
    if persistent.unlock_normal_end:
        $ true_end_point += 1
    if true_end_point >= 2:
        $ true_end = True

    menu:
        "请选择你要阅读的内容。"
        "关于四个结局的攻略提示":
            call tutorial_menu from _call_tutorial_menu
            return
        "TRUE END":
            scene black with dissolve
            if true_end:
                jump true_end
            else:
                "解锁HE、NE、BE中任意两个结局解锁本故事。"
                return
