# game/script/daily_pastime.rpy:109
translate japanese read_book_2b38597a:
    # Y "好啊，那么请你把书给我吧。"
    Y "いいよ、じゃあその本をこっちに渡してくれ。"
# game/script/daily_pastime.rpy:128
translate japanese read_book_9d33644a:
