# game/script/daily_bath.rpy:16
translate japanese daily_bath_daa885ae:

    # sy "夜神月看起来身体不适，需要尽快喂食药物。"
    sy "夜神月の体調が悪いようだ。できるだけ早く薬を飲ませる必要がある。"

# game/script/daily_bath.rpy:20
translate japanese daily_bath_ba1b8656:

    # sy "不消耗行动点数，你还剩下[action_points]点行动点数。"
    sy "行動ポイントは消費しません。残りの行動ポイントは[action_points]点です。"

# game/script/daily_bath.rpy:29
translate japanese daily_bath_018650ad:

    # "月对拿着洗漱用具的L露出无奈的表情。"
    "月は洗面用具を持ったＬに困惑した表情を浮かべた。"

# game/script/daily_bath.rpy:30
translate japanese daily_bath_0cb83149:

    # Y "我已经很干净了，不需要清洁。"
    Y "僕はもう十分清潔だ。今はそんなの必要ない。"

# game/script/daily_bath.rpy:40
translate japanese daily_bath_018650ad_1:

    # "月对拿着洗漱用具的L露出无奈的表情。"
    "月は洗面用具を持ったＬに困惑した表情を浮かべた。"

# game/script/daily_bath.rpy:41
translate japanese daily_bath_0cb83149_1:

    # Y "我已经很干净了，不需要清洁。"
    Y "僕はもう十分清潔だ。今はそんなの必要ない。"

# game/script/daily_bath.rpy:52
translate japanese bath1_5a57bd11:

    # "L拿来了换洗衣服，漱口水，水盆和毛巾，囚室里装有热水管道，对于洗漱来说方便很多。"
    "Lは着替え、マウスウォッシュ、たらい、タオルを持ってきた。牢獄には給湯管が通っており、洗面や身支度には不自由しない環境だった。"

# game/script/daily_bath.rpy:52
translate japanese bath1_d082767a:

    # "先把脏衣服换掉吧，L想，不过夜神君如果趁机攻击自己会很苦恼啊。"
    "まずは汚れた服を着替えさせよう、とLは思った。ただ、夜神くんがこの機に乗じて自分を攻撃してきたらとても困る。"

# game/script/daily_bath.rpy:57
translate japanese bath1_181e884a:

    # L order2 "夜神君，为了换衣服和擦身我会分别解开你的手铐和脚铐，"
    L order2 "夜神くん、着替えと体を拭く為に、手錠と足枷を外します。"

# game/script/daily_bath.rpy:57
translate japanese bath1_0659b6e8:

    # L order2 "我建议他放弃趁机攻击我的念头，渡在那边实时监控着，如果我有什么意外夜神君也不会得到好结果的。"
    L order2 "今がチャンスと私を攻撃する考えは捨ててください。ワタリがこの部屋をリアルタイムで監視しています。もしも私に何かあれば、夜神くんにとっていい結果にはなりません。"

# game/script/daily_bath.rpy:61
translate japanese bath1_fa748b7c:

    # Y "我不会做没有成功率的蠢事的。只要你别对我动手动脚就行。"
    Y "そんな成功率の低い無謀なことなんてするわけないだろう。おまえが余計なことさえしなければ大丈夫だ。"

# game/script/daily_bath.rpy:63
translate japanese bath1_26060d73:

    # "月的嫌恶显而易见。"
    "月の嫌悪は明らかだった。"

# game/script/daily_bath.rpy:65
translate japanese bath1_bca212ad:

    # "L首先解开了月的手铐。"
    "Lはまず月の手錠を解いた。"

# game/script/daily_bath.rpy:67
translate japanese bath1_b69471f9:

    # Y "我可以自己换衣服和擦身。"
    Y "着替えと身体を拭くことくらい、自分でできる。"

# game/script/daily_bath.rpy:72
translate japanese bath1_224ca78d:

    # "L注视着月自己换了上衣，用湿毛巾擦了身体，脸和脖子，顺便漱了口。"
    "Lは月が自分で服を着替え、濡れタオルで身体と顔、首を拭い、ついでに口をゆすぐのをじっと見つめていた。"

# game/script/daily_bath.rpy:72
translate japanese bath1_867352d1:

    # "L重新把月的双手铐在背后。"
    "Lは月の両手を背後で再び手錠で拘束した。"

# game/script/daily_bath.rpy:72
translate japanese bath1_a3e2aff8:

    # "L解开了月的脚铐，脱掉了月的囚裤。"
    "Lは月の足錠を外し、囚人用ズボンを脱がせた。"

# game/script/daily_bath.rpy:78
translate japanese bath1_8d58b987:

    # Y "不用帮我擦了，直接换衣服就行。"
    Y "拭かなくていい、着替えだけで十分だ。"

# game/script/daily_bath.rpy:84
translate japanese bath1_38793c20:

    # L "夜神君不愿意就算了。"
    L "夜神くんが望まないなら、無理にとは言いません。"

# game/script/daily_bath.rpy:88
translate japanese bath1_19d77b71:

    # "L拿出换洗衣服，帮月换上。"
    "Lは着替えを取り出して、月に着替えさせた。"

# game/script/daily_bath.rpy:88
translate japanese bath1_823a43b8:

    # "期间月好像是在逃避现实似的，干脆闭上了眼睛。"
    "この間、月は現実逃避するかのように、潔く目を閉じていた。"

# game/script/daily_bath.rpy:94
translate japanese bath1_ae3f5650:

    # "衣服很快就换好了。"
    "着替えはすぐに終わった。"

# game/script/daily_bath.rpy:94
translate japanese bath1_2dd4f094:

    # "新衣服有淡淡的洗涤剂的清香。"
    "新しい服からは洗剤のほのかな香りがただよう。"

# game/script/daily_bath.rpy:94
translate japanese bath1_266b06c2:

    # "但是月还是感觉身上和头发有些油腻，现在只能忍耐下来。"
    "月は、肌や髪のベタつきを依然感じつつも、今は耐えるしかなかった。"

# game/script/daily_bath.rpy:111
translate japanese bath1_aab6674b:

    # L "不行，清洁必须做彻底才可以。"
    L "ダメです。清潔にするなら徹底的にやらなければ。"

# game/script/daily_bath.rpy:114
translate japanese bath1_0f6236e9:

    # Y "你能不能听人说话啊！？"
    Y "人の話を聞いていないのか！？"

# game/script/daily_bath.rpy:120
translate japanese bath1_697a8a33:

    # "月抬腿就想踹L，被一把捉住了脚腕，另一条腿还想踹，但是被L躲过去了，站在了踹不到的死角。"
    "月は脚を上げてLを蹴ろうとしたが、足首を掴まれた。もう一方の脚でも蹴ろうとしたが、Lは素早くかわし、蹴りの届かない死角に立った。"

# game/script/daily_bath.rpy:120
translate japanese bath1_7350946e:

    # "月因为失衡，上半身后仰躺在了床上。"
    "月はバランスを崩し、上半身を反らせたままベッドに倒れ込んだ。"

# game/script/daily_bath.rpy:124
translate japanese bath1_bd8ff12b:

    # L "如果夜神君配合的话很快就好了。"
    L "夜神くんが協力してくれれば、すぐに終わります。"

# game/script/daily_bath.rpy:126
translate japanese bath1_29bd2803:

    # "温热的毛巾从内裤下缘的大腿根部下行，一直到脚腕，"
    "温かいタオルがパンツの裾から太ももの付け根を通り、足首まで下りてきた。"

# game/script/daily_bath.rpy:126
translate japanese bath1_018d6b93:

    # "然后L在水盆里拧了一把毛巾，把月的脚背脚心脚趾间也擦了一遍。"
    "続けてLは水盆でタオルを固く絞り、月の足の甲から足裏、指の間に至るまで丁寧に拭っていった。"

# game/script/daily_bath.rpy:134
translate japanese bath1_ac76eada:

    # "在捏到脚心的时候，月浑身颤了一下。"
    "足の裏を揉まれた時、月は全身に震えが走った。"

# game/script/daily_bath.rpy:136
translate japanese bath1_d4378861:

    # Y jiaoji2 "……变态。（咬牙切齿）"
    Y jiaoji2 "…変態め。（歯ぎしりしながら）"

# game/script/daily_bath.rpy:138
translate japanese bath1_6c8b816a:

    # L "……？"
    L "……？"

# game/script/daily_bath.rpy:142
translate japanese bath1_cb802fcc:

    # "清洁完之后，L给月换上了新的囚裤，重新铐好脚铐，把脏衣服和清洁器具带出了房间。"
    "身体の清潔作業が終わると、Lは月に新しい囚人用ズボンを履かせ、再び足錠をはめ、汚れた衣服と清掃用具を部屋から持ち出した。"

# game/script/daily_bath.rpy:150
translate japanese bath2_f18946ec:

    # "L拿来了洗发水，梳子，吹风机，漱口水，水盆和毛巾，囚室里装有热水管道和插座，对于洗漱来说方便很多。"
    "Lはシャンプー、櫛、ドライヤー、洗口液、洗面器、タオルを準備した。牢獄には湯が出る水道とコンセントが備わっており、体を清潔にするのにかなり便利だった。"

# game/script/daily_bath.rpy:152
translate japanese bath2_d08b82f5:

    # L "夜神君已经知道该怎么做了吧？"
    L "夜神くんは、もう何をすべきか分かっているでしょう？"

# game/script/daily_bath.rpy:154
translate japanese bath2_be773eb3:

    # Y "我也很好奇你是怎么做到把每句话都说得这么恶心的。"
    Y "毎回毎回、どうしてそんな風に気持ち悪く言えるんだよ。"

# game/script/daily_bath.rpy:156
translate japanese bath2_f6a744b7:

    # L "我可没说什么，是夜神君自己理解歪了。今天要给夜神君洗头，麻烦站到洗手池这边来。"
    L "私は何も言ってません、夜神くんの誤解です。今日は洗髪をしますので、洗面台の方まで来てください。"

# game/script/daily_bath.rpy:164
translate japanese bath2_56e02429:

    # "月不情不愿地站到洗手池旁边，弯下腰。头皮确实有些油腻了，出于洁癖他也只能配合L的行动。"
    "月は不機嫌そうに洗面台の横に移動し、腰をかがめた。確かに頭皮が油っぽく、潔癖症の彼はLの行動に従うしかなかった。"

# game/script/daily_bath.rpy:167
translate japanese bath2_0d109b17:

    # L "我还没有给别人洗过头呢。"
    L "私、人にシャンプーするのは初めてでして。"

# game/script/daily_bath.rpy:169
translate japanese bath2_5ae810e8:

    # Y "那我可真是荣幸啊。"
    Y "それは光栄だな。"

# game/script/daily_bath.rpy:171
translate japanese bath2_6e86c47d:

    # L "我的意思是如果水温和力道不合适麻烦夜神君说出来。"
    L "お湯の温度や力加減が合わなかったら、夜神くんから言ってください。"

# game/script/daily_bath.rpy:172
translate japanese bath2_9b60f496:

    # voice "audio/sound/short_punch1.mp3"
    # Y renzhen "……喂，这是冷水啊！"
    voice "audio/sound/short_punch1.mp3"
    Y renzhen "……おい、これ水だぞ！"

# game/script/daily_bath.rpy:176
translate japanese bath2_2bec0dee:

    # L unhappy "抱歉。"
    L unhappy "あ、すみません。"

# game/script/daily_bath.rpy:178
translate japanese bath2_9af91358:

    # Y Light "……烫了。"
    Y Light "……熱っ！注意しろよ"

# game/script/daily_bath.rpy:180
translate japanese bath2_c85972df:

    # L unhappy "好麻烦。"
    L unhappy "面倒ですね…。"

# game/script/daily_bath.rpy:184
translate japanese bath2_25d213c2:

    # "总算调到了合适的水温，L挤了一泵洗发水在手上，揉搓出泡沫，再抹到月的头发上。"
    "ようやく適温に調整すると、Lはシャンプーを一押し手に取り、泡立てて月の髪に揉み込んだ。"

# game/script/daily_bath.rpy:184
translate japanese bath2_6a873a3f:

    # "青年的发丝很柔顺，打湿了之后像某种动物的毛发，贴在头皮上。"
    "青年の髪はなめらかで、濡れると動物の毛のように頭皮に張り付いた。"

# game/script/daily_bath.rpy:184
translate japanese bath2_bdff5152:

    # "L笨拙地按摩了几下，不得要领，就草草把所有的发丝打上泡沫了事。"
    "Lは不器用に数回揉んだが、上手くできず、ささっと髪全体を泡で覆った。"

# game/script/daily_bath.rpy:184
translate japanese bath2_6a66ed25:

    # "用水流把泡沫冲掉之后，L先用干毛巾把月的头包起来，挤压了一下水分，然后插上吹风机帮忙把头发吹干。"
    "泡をお湯で洗い流した後、Lはまず乾いたタオルで月の頭を包み込み、水分を軽く押し絞ってから、ドライヤーをコンセントに繋ぎ、髪を乾かしはじめた。"

# game/script/daily_bath.rpy:197
translate japanese bath2_14b831d6:

    # "月的声音在吹风机的隆隆声中有些听不清。"
    "月の声はドライヤーの轟音にかき消され、はっきりと聞き取れなかった。"

# game/script/daily_bath.rpy:199
translate japanese bath2_8ae1790b:

    # Y "你照顾人的手法真的是有够烂。"
    Y "おまえ、世話の仕方が本当に下手くそだな。"

# game/script/daily_bath.rpy:201
translate japanese bath2_d96ba55e:

    # L "所以我提前说了请多包涵。"
    L "ですから先にご了承くださいとお伝えしましたよね、夜神くん。"

# game/script/daily_bath.rpy:203
translate japanese bath2_d9294c88:

    # Y "那你把手铐解开让我自己做不就行了。"
    Y "なら、手錠外して僕自身にやらせてくれればいいだろう。"

# game/script/daily_bath.rpy:205
translate japanese bath2_7e9f4b30:

    # L unhappy "总感觉夜神君会揍我。"
    L unhappy "どうも夜神くんが殴りかかってきそうな気がするんです。"

# game/script/daily_bath.rpy:207
translate japanese bath2_93abe0fb:

    # "月哼笑一声。"
    "月は鼻で笑った。"

# game/script/daily_bath.rpy:209
translate japanese bath2_c1d88e97:

    # Y smile2 "你还挺有自知之明。"
    Y smile2 "おまえ、そういう自覚あるんだな。"

# game/script/daily_bath.rpy:214
translate japanese bath2_9db43009:

    # "吹完头发，L用梳子简单地帮月梳了头发，感觉有点长长了。"
    "髪を乾かし終えると、Lは櫛を手に取り、月の髪をざっと梳いた。指先に伝わる感触から、その髪が少し伸びてきていると感じられた。"

# game/script/daily_bath.rpy:214
translate japanese bath2_c783485e:

    # "L想起这种既视感是在宠物美容店，店员给小猫小狗洗完澡之后吹干梳毛。"
    "Lはこの既視感が、ペット美容店で店員が子猫や子犬のシャンプー後に毛を乾かして整えている光景と重なると気づく。"

# game/script/daily_bath.rpy:214
translate japanese bath2_7d4e3f71:

    # "不过这个不能告诉夜神君吧，他肯定会生气的。"
    "ただし、これは夜神くんには伝えられない。きっと怒られる。"

# game/script/daily_bath.rpy:222
translate japanese bath2_81c12365:

    # L pt "今天的擦身就由我代劳吧。"
    L pt "今日の身体拭きは私がお手伝いします。"

# game/script/daily_bath.rpy:224
translate japanese bath2_f4c276f4:

    # Y renzhen "……喂！"
    Y renzhen "…おい！"

# game/script/daily_bath.rpy:226
translate japanese bath2_11491a87:

    # "无视月的反抗，L把囚衣的下摆撩到月的锁骨处，白皙柔软的腹部露了出来。"
    "月の抵抗を無視し、Lは囚人服の裾を鎖骨あたりまでまくり上げる。白く柔らかな腹部が露わになった。"

# game/script/daily_bath.rpy:226
translate japanese bath2_c3257d30:

    # "腹部是所有动物的弱点呢。L漫不经心地想。"
    "腹部は全ての動物の弱点だな。と、Lは何気なく考えた。"

# game/script/daily_bath.rpy:226
translate japanese bath2_1aee2b2c:

    # "用浸湿的毛巾快速擦拭了月的前胸、腹部和后背，又拧了一次水擦拭了月的脖子和脸颊。"
    "濡れたタオルで月の胸、腹部、背中を素早く拭い、再度絞り直して首筋と頬を拭った。"

# game/script/daily_bath.rpy:226
translate japanese bath2_8c8556fa:

    # "接下来应该擦下半身了。"
    "次は下半身を拭う番だった。"

# game/script/daily_bath.rpy:234
translate japanese bath2_b1e91422:

    # L "夜神君要帮忙擦下面吗？"
    L "夜神くん、次は下半身を拭きましょうか？"

# game/script/daily_bath.rpy:236
translate japanese bath2_7f4d1612:

    # Y angry "这还用问吗？你觉得我像是想跟你肢体接触的样子？"
    Y angry "そんなの聞くまでもないだろ。僕がお前と触れ合いたがってるように見えるのか？"

# game/script/daily_bath.rpy:238
translate japanese bath2_cff410e2:

    # L "下次清洁要等到几天后了，如果夜神君不会难受也可以。"
    L "次回の清拭は数日後になりますが、夜神くんが気にならなければそのまま次回に持ち越しても結構です。"

# game/script/daily_bath.rpy:240
translate japanese bath2_fc025ef0:

    # Y "……"
    Y "……"

# game/script/daily_bath.rpy:242
translate japanese bath2_05edd1e0:

    # Y "你如果敢乱摸我就杀了你。"
    Y "変な触り方したら、本当にお前を殺すからな。"

# game/script/daily_bath.rpy:244
translate japanese bath2_8747fdac:

    # L "好可怕啊，夜神君。（无感情）"
    L "それはそれは、怖いですね夜神くん。（無感情）"

# game/script/daily_bath.rpy:252
translate japanese bath2_eab4eb3a:

    # L "算了，既然夜神君这么不情愿，我也不勉强你了。"
    L "仕方ありません。夜神くんがそこまで嫌なら、無理強いはいったん控えておきましょう。"

# game/script/daily_bath.rpy:256
translate japanese bath2_a2af25c9:

    # "L把洗漱用具收拾好离开了囚室。"
    "Lは清掃用具を片付けると、牢獄を後にした。"

# game/script/daily_bath.rpy:256
translate japanese bath2_571fdedc:

    # "月松了一口气，虽然感觉身上没有清洁干净不太舒服，但是也只能忍耐了。"
    "月はほっと一息ついた。体が十分に清潔になっていないのは気持ち悪かったが、我慢するしかなかった。"

# game/script/daily_bath.rpy:268
translate japanese bath2_be5d9610:

    # "L把月的黑色长裤脱到脚踝的位置，用浸湿的毛巾擦过月笔直修长的双腿。"
    "Lは月の黒いスラックスをくるぶしまで下げて脱がせ、濡れたタオルで脚を拭っていく。"

# game/script/daily_bath.rpy:268
translate japanese bath2_792fadea:

    # "毛巾在蹭过敏感的大腿内侧和足心的时候令月有些不适，不过L确实没有乱摸，他也没理由说什么。"
    "タオルが敏感な太もも内側や足の裏をこするたびに月は少しばかり不快を覚えたが、Lは確かに無用な接触はせず、文句を言う理由もなかった。"

# game/script/daily_bath.rpy:268
translate japanese bath2_70b21ca0:

    # "擦完之后他松了一口气，等L帮他把裤子穿上。"
    "拭き終えると月は安堵の息をつき、Lがズボンを穿かせるのを待った。"

# game/script/daily_bath.rpy:268
translate japanese bath2_325e900a:

    # "当囚裤的面料重新覆盖皮肤，月感到了一丝安全感。"
    "囚人用ズボンの生地が再び肌を覆うと、月はかすかな安堵感を覚えた。"

# game/script/daily_bath.rpy:276
translate japanese bath2_0d566571:

    # L "今天先到这里吧。"
    L "今日はここまでにしましょう。"

# game/script/daily_bath.rpy:278
translate japanese bath2_01a3c825:

    # "L离开了囚室。"
    "Lは牢獄を後にした。"

# game/script/daily_bath.rpy:286
translate japanese bath2_be5d9610_1:

    # "L把月的黑色长裤脱到脚踝的位置，用浸湿的毛巾擦过月笔直修长的双腿。"
    "月の黒いスラックスをくるぶしまで下げて脱がせ、濡れたタオルで脚を拭っていく。"

# game/script/daily_bath.rpy:286
translate japanese bath2_792fadea_1:

    # "毛巾在蹭过敏感的大腿内侧和足心的时候令月有些不适，不过L确实没有乱摸，他也没理由说什么。"
    "タオルが敏感な太もも内側や足の裏をこするたびに月は少しばかり不快を覚えたが、Lは確かに無用な接触はせず、文句を言う理由もなかった。"

# game/script/daily_bath.rpy:286
translate japanese bath2_70b21ca0_1:

    # "擦完之后他松了一口气，等L帮他把裤子穿上。"
    "拭き終えると月は安堵の息をつき、Lがズボンを穿かせるのを待った。"

# game/script/daily_bath.rpy:286
translate japanese bath2_1dffc0ea:

    # "但是与他的预料相反，布料没有重新包裹住他的双腿，反而是贴身的布料也被扯下，褪到膝弯。"
    "しかし彼の予想に反し、布地は再び脚を覆うどころか、むしろ肌に密着した下着の生地までもが引き剥がされ、膝裏までずり下げられた。"

# game/script/daily_bath.rpy:286
translate japanese bath2_5c271a4f:

    # "月的脸上染上了一层薄红，不知道是羞得还是气得。"
    "恥ずかしさからか、それとも怒りからか、月の顔に薄らと赤みが差した。"

# game/script/daily_bath.rpy:296
translate japanese bath2_5f544d50:

    # Y yaoya2 "喂，你在干什么？？"
    Y yaoya2 "おい、何をしているんだ？？"

# game/script/daily_bath.rpy:298
translate japanese bath2_b74a67ff:

    # "L拿来一条毛巾。"
    "Lはタオルを一枚持ってきた。"

# game/script/daily_bath.rpy:300
translate japanese bath2_d0de6ff9:

    # L smile1 "帮夜神君清洁啊，生殖器官会分泌很多分泌物，如果不定时清洁也会很脏的。"
    L smile1 "夜神くんのお手伝いをしているんです。性器は分泌物が多く、こまめに洗わないと汚れが溜まりやすいですから。"

# game/script/daily_bath.rpy:302
translate japanese bath2_fe715dde:

    # Y "你已经让我感觉不适了，L，你这是性骚扰！"
    Y "もう十分不快だ、L！これは完全なセクハラだ！"

# game/script/daily_bath.rpy:304
translate japanese bath2_5ac18887:

    # L "麻烦夜神君忍耐一下吧，毕竟如果发炎了会很麻烦呢。"
    L "申し訳ないですが、少し我慢してください、夜神くん。炎症でも起こしたら大変ですから。"

# game/script/daily_bath.rpy:308
translate japanese bath2_ea550d3a:

    # "L拿着毛巾的手握住了月的阴茎，揉搓清洁起来。"
    "Lはタオルを握った手で月の陰茎を握り、揉むように清拭を始めた。"

# game/script/daily_bath.rpy:310
translate japanese bath2_c5d5460b:

    # Y "（简直就像是在帮忙手淫一样……真的是疯了……）"
    Y "（まるで自慰の介助でもされているみたいだ……本当に狂ってる……）"

# game/script/daily_bath.rpy:312
translate japanese bath2_818d528b:

    # "已经长期禁欲的身体根本经不起挑拨，在清洁到敏感的龟头时，月已经完全勃起了，前列腺液也缓缓溢出。"
    "長いあいだ禁欲してきた身体は、わずかな刺激にも耐えられなかった。敏感な亀頭を清められるうちに、月はすっかり勃ち上がり、先端からは透明な液が静かに滲み始めていた。"

# game/script/daily_bath.rpy:314
translate japanese bath2_b80f25f0:

    # L "夜神君勃起了，没关系吗？"
    L "夜神くん、勃起してきましたが……大丈夫ですか？"

# game/script/daily_bath.rpy:316
translate japanese bath2_9ca1da25:

    # Y "你这……混账……"
    Y "お前……クソッ……"

# game/script/daily_bath.rpy:319
translate japanese bath2_298b5fa6:

    # "情欲的火焰久违地在身体里燃烧起来，月甚至不敢过多开口，害怕直接在L面前呻吟出声。"
    "久しく忘れていた情欲の炎が体の奥で燃え上がり、月はLの前でうっかり声を漏らしてしまうのが怖くて、口を開くことすら出来なかった。"

# game/script/daily_bath.rpy:319
translate japanese bath2_2658e32c:

    # "大脑被刺激得头皮发麻，小腹也紧缩着，抵抗想要更多的抚摸然后射精的想法。"
    "脳髄を痺れさせるほどの快感に頭皮が震え、下腹部も強く収縮する。もっと撫でてほしいという欲望と、射精したいという衝動に、月は必死に抗っていた。"

# game/script/daily_bath.rpy:319
translate japanese bath2_5f8b11b4:

    # "L用食指和拇指捏住月挺立的龟头，语调还是一样平静。"
    "Lは人差し指と親指で月の勃ち上がった亀頭をつまみ、その声の調子は相変わらず落ち着いていた。"

# game/script/daily_bath.rpy:325
translate japanese bath2_e0ca56fd:

    # L "夜神君，你想射出来吗？出于对生理健康的建议，我觉得射出来比较好。"
    L "夜神くん、射精したいですか？　健康のためにも、我慢せずに出されたらどうですか。"

# game/script/daily_bath.rpy:327
translate japanese bath2_4aa5c717:

    # "囚室里回荡着月急促的喘息声。"
    "牢獄の中では、月の荒い息遣いが反響していた。"

# game/script/daily_bath.rpy:327
translate japanese bath2_f6b64cdd:

    # "他闭上眼睛，不愿意去看自己被宿敌拿捏的丑态。"
    "月は目を閉じ、宿敵に弄ばれる自分の醜態を見ないように努める。"

# game/script/daily_bath.rpy:327
translate japanese bath2_2ae55633:

    # "他知道L在逼迫自己屈服。"
    "Lは自分を屈服させようとしている。と、月は確信した。"

# game/script/daily_bath.rpy:333
translate japanese bath2_e25006d1:

    # Y yaoya "不需要。"
    Y yaoya "……必要ない。"

# game/script/daily_bath.rpy:335
translate japanese bath2_4a0a758a:

    # L order2 "我知道了。"
    L order2 "分かりました。"

# game/script/daily_bath.rpy:339
translate japanese bath2_eab1268b:

    # "脆弱部位传来一阵疼痛，立刻浇熄了欲火。"
    "敏感な場所に走った鋭い痛みが、燃え上がっていた情欲を一瞬で打ち砕いた。"

# game/script/daily_bath.rpy:339
translate japanese bath2_e6f7e10d:

    # "L用纸巾擦干净溢出的前液，帮月穿好了裤子，拿着洗漱器具离开了囚室。"
    "Lは溢れた先走りをティッシュで拭き取り、月にズボンを履かせてから、洗面用具を持って独房を後にした。"

# game/script/daily_bath.rpy:339
translate japanese bath2_a16c586d:

    # "月瘫在床上，后知后觉地出了一身细汗，欲望被强行打断，所以并没有满足的感觉，而是一种空虚感。"
    "月はベッドに力なく倒れ込み、遅れて全身に汗がにじんでいることに気づいた。強引に欲望を断ち切られたせいで、快楽も充足もなく、ただ虚しさだけが胸を占めていた。"

# game/script/daily_bath.rpy:339
translate japanese bath2_208b06f4:

    # "他无意识地摩擦了几下大腿，脚铐被挣出稀碎的响声。"
    "月は無意識に太腿を数回擦り合わせ、足枷がきしんで細かく砕けるような音を立てた。"

# game/script/daily_bath.rpy:355
translate japanese bath3_7be19f2f:

    # "L拿来了漱口水，水盆和毛巾，囚室里装有热水管道，对于洗漱来说方便很多。"
    "Lは洗口液、洗面器、タオルを用意した。牢獄には湯が出る配管が備わっており、洗浄においては非常に便利だった。"

# game/script/daily_bath.rpy:355
translate japanese bath3_fd3f976d:

    # "月看着L倒了一瓶盖漱口水递过来，皱起眉头："
    "Lがキャップにマウスウォッシュを注ぎ、それを差し出してくるのを見て、月は不快そうに眉を寄せた。"

# game/script/daily_bath.rpy:359
translate japanese bath3_3af298ae:

    # Y "龙崎，能把手铐和脚铐解开让我自己洗漱吗？"
    Y "竜崎、拘束を外して自分で洗わせてくれないか？"

# game/script/daily_bath.rpy:366
translate japanese bath3_ccd461ef:

    # Y "好吧，如果你坚持我也没办法。"
    Y "わかった、そこまで言うなら仕方ない。"

# game/script/daily_bath.rpy:368
translate japanese bath3_90ae5c88:

    # "月在L的帮助下用漱口水漱了口，用毛巾擦了脸和脖子。"
    "月はLの手を借りてマウスウォッシュで口をゆすぎ、タオルで顔と首を拭った。"

# game/script/daily_bath.rpy:371
translate japanese bath3_b63e1b9b:

    # Y "谢谢。"
    Y "どうも。"

# game/script/daily_bath.rpy:372
translate japanese bath3_9225c0a0:

    # "月活动了一下手腕和脚腕，用漱口水漱了口，用毛巾擦了脸和脖子。"
    "月は自由になった手足を少し動かし、マウスウォッシュで口をゆすぎ、タオルで顔と首を拭った。"

# game/script/daily_bath.rpy:375
translate japanese bath3_c9f300a1:

    # "结束之后，月被重新带上了镣铐。"
    "終了後、月は再び手錠と足錠をかけられた。"

# game/script/daily_bath.rpy:377
translate japanese bath3_e63a20f8:

    # L "需要帮忙擦身吗？"
    L "身体拭きのお手伝いをしましょうか。"

# game/script/daily_bath.rpy:379
translate japanese bath3_f8668db6:

    # Y "不用了。"
    Y "結構だ。"

# game/script/daily_bath.rpy:386
translate japanese bath3_8f482e7c:

    # "L闻言没有强迫月，而是直接离开了。"
    "Lはそれを聞いて月を無理強いすることはせず、そのまま立ち去った。"

# game/script/daily_bath.rpy:393
translate japanese bath3_b11613c7:

    # "L无视月的拒绝，强行把衣服撩了起来，用温热的毛巾擦洗月的身体。"
    "Lは月の拒絶を無視して服を強引にまくり上げると、温かいタオルでその身体を拭いていった。"

# game/script/daily_bath.rpy:396
translate japanese bath3_bc21bb34:

    # Y jiaoji1 "喂！你是听不懂人话吗！"
    Y jiaoji1 "おい！人の話を聞け！"

# game/script/daily_bath.rpy:397
translate japanese bath3_20ff01f9:

    # "夜神月显得非常气愤。"
    "夜神月は激しく憤慨した。"

# game/script/daily_bath.rpy:398
translate japanese bath3_0edd8978:

    # "不过受到镣铐的限制，他没法做出有效的反抗，只能忍耐……"
    "しかし拘束具のせいで、まともな抵抗もできず、ただ耐えるしかなかった……。"

# game/script/daily_bath.rpy:406
translate japanese bath4_26489a9f:

    # "L拿来了换洗衣服，牙缸，牙膏和牙刷，水盆和毛巾，囚室里装有热水管道，对于洗漱来说方便很多。"
    "Lは着替え、歯磨きコップ、歯磨き粉と歯ブラシ、洗面器、タオルを用意した。牢獄には湯が出る水道とコンセントが備わっており、洗面には非常に便利だった。"

# game/script/daily_bath.rpy:408
translate japanese bath4_c875f395:

    # Y "你还要坚持让我带着手铐和脚铐换洗吗？我不会袭击你的，我只想好好清洗自己。"
    Y "竜崎、手錠や足枷をつけたまま着替えさせるつもりか？　襲ったりなんかしない。ただ、普通に体を清潔にしたいだけだ。"

# game/script/daily_bath.rpy:410
translate japanese bath4_fe244b88:

    # "看着月诚恳的脸，L放软了态度，给月解开手铐和脚铐。"
    "月の誠実な表情を見て、Lは態度を和らげ、月の手錠と足錠を解いた。"

# game/script/daily_bath.rpy:410
translate japanese bath4_4a610b11:

    # "月先刷了牙，漱过口之后，把洗具整理整齐，然后看了L一眼。"
    "月はまず歯を磨き、口をゆすいだ後、洗面用具をきちんと整え、そしてLを一瞥した。"

# game/script/daily_bath.rpy:410
translate japanese bath4_75c62d91:

    # "L意识到月要脱衣服擦身了。"
    "Lは、月が服を脱いで体を拭こうとしていることに気づいた。"

# game/script/daily_bath.rpy:421
translate japanese bath4_5601c56e:

    # "月有些不高兴，但是也没有说什么，迅速换完了衣服。"
    "月は少し不機嫌そうだったが、何も言わずに素早く着替えを終えた。"

# game/script/daily_bath.rpy:430
translate japanese bath4_95ec3881:

    # "L会意地转过身去，背对着月。"
    "Lは意を汲んでくるりと背を向け、月に背を向けた。"

# game/script/daily_bath.rpy:430
translate japanese bath4_718b48cc:

    # "身后传来细碎的脱衣服的声音。"
    "背後からは、衣類を脱ぐ細かい音が伝わってきた。"

# game/script/daily_bath.rpy:430
translate japanese bath4_3359d5c7:

    # "然后是水流声，蓄满了水盆。毛巾在水盆里被浸湿，然后拿起来拧干，发出哗啦啦的水声。"
    "次に水音がし、洗面器に水が満たされる。タオルが洗面器の中で浸され、絞られると、ざあざあと水音を立てた。"

# game/script/daily_bath.rpy:430
translate japanese bath4_930a83bc:

    # "湿润的毛巾擦拭身体的声音几近于无。"
    "湿ったタオルが身体を拭く音は、ほとんど聞こえなかった。"

# game/script/daily_bath.rpy:430
translate japanese bath4_374db495:

    # "L无聊地盯着自己的脚趾甲盖看。"
    "Lは退屈そうに自分の足の爪を眺めていた。"

# game/script/daily_bath.rpy:440
translate japanese bath4_81a14b1d:

    # Y "已经可以了。"
    Y "もう大丈夫だ。"

# game/script/daily_bath.rpy:444
translate japanese bath4_54ad785a:

    # "L转身，看见月换上了新的囚服，洗具和换洗下来的衣服已经整理好了，叠放在水盆里。"
    "Lが振り返ると、月は新しい囚人服に着替えており、洗面用具と着替えた衣服はきちんと整えられ、洗面器の中に重ねて置いてあった。"

# game/script/daily_bath.rpy:444
translate japanese bath4_3f77c4ef:

    # "L拿起盆离开了囚室。"
    "Lは洗面器を手に取ると、牢獄を後にした。"

