translate japanese true_end_580d97ef:

    # L "雷姆对于人类的法律了解吗？"
    L "レム、あなたは人間の法律についてどの程度理解していますか？"

# game/script/extra_story.rpy:159
translate japanese true_end_a23b693d_1:

    # Rem "……"
    Rem "……"

