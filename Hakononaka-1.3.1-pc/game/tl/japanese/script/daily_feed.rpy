# game/script/daily_feed.rpy:68
translate japanese daily_feed_01d75b08:

    # sy "是否给夜神月喂药恢复健康？" nointeract
    sy "夜神月に薬を与えて健康値を回復させますか？" nointeract

# game/script/daily_feed.rpy:71
translate japanese daily_feed_5c3b62cc:

    # "夜神月皱着眉把药吞了下去。"
    "夜神月は眉をひそめて薬を飲み込んだ。"

# game/script/daily_feed.rpy:72
translate japanese daily_feed_28dacdcb:

    # "好好休息就会恢复健康吧。"
    "しっかり休めば、健康値は回復するだろう。"

# game/script/daily_feed.rpy:73
translate japanese daily_feed_d7b2b897:

    # sy "健康值恢复30点。"
    sy "健康値が30ポイント回復した。"

# game/script/daily_feed.rpy:78
translate japanese daily_feed_79b82db5:

    # "你不想做没有意义的事情，这是你的选择。"
    "意味のないことをしたくない、これはあなたの選択だ。"

# game/script/daily_feed.rpy:95
translate japanese daily_feed_e6cca05c:

    # "月对拿着食物的L露出无奈的表情。"
    "月は食べ物を持ったLに向かって、呆れたような表情を浮かべた。"

# game/script/daily_feed.rpy:96
translate japanese daily_feed_725b301f:

    # Y "我现在吃不下这么多。"
    Y "今、こんなにたくさん食べられない。"

# game/script/daily_feed.rpy:108
translate japanese daily_feed_e6cca05c_1:

    # "月对拿着食物的L露出无奈的表情。"
    "月は食べ物を持ったLに向かって、呆れたような表情を浮かべた。"

# game/script/daily_feed.rpy:109
translate japanese daily_feed_725b301f_1:

    # Y "我现在吃不下这么多。"
    Y "今、こんなにたくさん食べられない。"

# game/script/daily_feed.rpy:123
translate japanese daily_feed_e6cca05c_2:

    # "月对拿着食物的L露出无奈的表情。"
    "月は食べ物を持ったLに向かって、呆れたような表情を浮かべた。"

# game/script/daily_feed.rpy:124
translate japanese daily_feed_725b301f_2:

    # Y "我现在吃不下这么多。"
    Y "今、こんなにたくさん食べられない。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_309c89fc:

    # "L端来了豪华寿司套餐。"
    "Lは豪華な寿司の盛り合わせを運んできた。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_fe99640d:

    # "新鲜的生鱼片上反射出油润的光泽，被摆成漂亮的花样放在寿司米上，旁边点缀以绿叶和淡雅的花朵，干冰的雾气萦绕而上。"
    "新鮮なネタが艶やかに光り、シャリの上に華やかに盛り付けられている。傍らには大葉と食用菊があしらわれ、ドライアイスの煙がゆらゆらと立ち上っていた。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_9ef63729:

    # "寿司的种类也相当丰富，甜虾、扇贝、鱿鱼等普通的款式簇拥着中间的金枪鱼大腹，整整齐齐摆出了豪迈的气势。"
    "ネタの種類もかなり豊富で、甘エビ、ホタテ、イカなど定番のネタが中央の大トロを取り囲み、きっちりと並べられた様は豪快な風格を放っている。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_39293741:

    # "精致典雅的餐具被摆在单独的餐盘上，酱油和磨好的山葵酱装在小碟里，供食客随意取用。"
    "精巧で上品な食器が膳に並び、醤油とすりおろしたワサビが小皿に盛られ、客が自由に使えるようになっていた。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_12cce148:

    # "L从餐车上取下一个巨大的餐盘，摆在狭小的囚室地面上，瞬间变得让人无从下脚。"
    "Lがワゴンから巨大な膳を取り出して独房の床に置くと、狭い空間は一気に埋め尽くされ、たちまち足の踏み場もなくなってしまった。"

# game/script/daily_feed.rpy:184
translate japanese food_h1_81057b4f:

    # "夜神月坐在硬板床上，看着满地的高级寿司沉默了几秒。"
    "夜神月は硬い簡易ベッドに座りながら、床に並べられた高級寿司を数秒間黙って見つめた。"

# game/script/daily_feed.rpy:199
translate japanese food_h1_972fb123:

    # Y smile2 "这是我的断头饭吗？"
    Y smile2 "これが僕の最後の食事か？"

# game/script/daily_feed.rpy:201
translate japanese food_h1_dc21e45b:

    # "夜神月讽刺地笑了。"
    "夜神月は嘲るように笑った。"

# game/script/daily_feed.rpy:203
translate japanese food_h1_866f7d08:

    # L "不用怀疑我的心意，请用吧，夜神君。"
    L "私の良心を疑わないでください。どうぞ、夜神君。"

# game/script/daily_feed.rpy:205
translate japanese food_h1_381e4995:

    # Y Light "龙崎，如果想看我的笑话，我劝你打消这个念头。我现在即使沦落至此，也不会求你做什么事情。"
    Y Light "竜崎、もし僕の醜態を見たいなら、その考えは捨てたほうがいい。たとえここまで落ちぶれても、僕はおまえに何かを頼んだりはしない。"

# game/script/daily_feed.rpy:207
translate japanese food_h1_0ac7a5bb:

    # "似乎是懒得和L讲更多的话，夜神月直接把眼睛闭了起来。"
    "Lとこれ以上話すのも面倒くさそうに、夜神月は直接目を閉じた。"

# game/script/daily_feed.rpy:207
translate japanese food_h1_b507fc1a:

    # "这也无可厚非，因为他双手被铐住，而这狭窄囚室内连一张桌子也没有，"
    "もっともなことだった。なぜなら月の両手は手錠で拘束されており、この狭い独房にはテーブルひとつない。"

# game/script/daily_feed.rpy:207
translate japanese food_h1_ab520354:

    # "如果不是快要饿死，这高傲的青年是不可能像低等动物一样伏下身趴在地上进食的。"
    "餓死しそうな状況でもなければ、この高慢な青年が下等動物のように身をかがめて床で食事をすることなどありえない。"

# game/script/daily_feed.rpy:207
translate japanese food_h1_eea006a0:

    # "他的潜台词已经相当明确了：如果诚心请他用餐，就拿出相应的尊重来。"
    "月の言いたいことははっきりしていた。もし本当に善意で食事を用意したなら、それに見合うだけの敬意を示せ、ということだ。"

# game/script/daily_feed.rpy:221
translate japanese food_h1_a074d06e:

    # L "夜神君，你似乎没有身为阶下囚的自觉。"
    L "夜神くんは、囚人としての自覚が足りないようですね。。"

# game/script/daily_feed.rpy:223
translate japanese food_h1_c841f2b8:

    # "夜神月闭着眼一动不动。"
    "夜神月は目を閉じたまま微動だにしなかった。"

# game/script/daily_feed.rpy:225
translate japanese food_h1_48a934ac:

    # Y "请回吧。记得把东西带走，如果要闻着腐烂的鱼腥味睡觉我也会很困扰的。"
    Y "帰ってくれ。ついでにこれも持っていけ。腐った魚の臭いを嗅ぎながら寝ることになるのは僕も困る。"

# game/script/daily_feed.rpy:227
translate japanese food_h1_5f6913b7:

    # "看来他是不会吃这些食物了，难得你准备了这么多。"
    "月はこの食物を食べるつもりはないらしい。せっかくこれだけ準備したのに。"

# game/script/daily_feed.rpy:229
translate japanese food_h1_022751ac:

    # "L收起餐盘，推着餐车离开了。"
    "Lは食器を片付け、ワゴンを押して去っていった。"

# game/script/daily_feed.rpy:231
translate japanese food_h1_2b3d9208:

    # "饱食度无变化。"
    "満腹度変化なし。"

# game/script/daily_feed.rpy:242
translate japanese food_h1_602f190d:

    # "L摆弄了一下餐车，那辆银白色的餐车隔板展开，支柱升降，变成了一张简单的桌子。"
    "Lがワゴンを少しいじると、銀白色のワゴンの仕切り板が展開し、支柱が昇降して、簡素なテーブルへと変形した。"

# game/script/daily_feed.rpy:242
translate japanese food_h1_bb366479:

    # "L将餐盘从地上拿起，放到了这张临时桌子上。"
    "Lは床からトレイを持ち上げ、仮設テーブルの上に置いた。"

# game/script/daily_feed.rpy:242
translate japanese food_h1_f78bac9f:

    # "随后，L取出一把细长的金属钥匙，打开了夜神月手上的镣铐，递给他一条热腾腾的白毛巾。"
    "その後、Lは細長い金属の鍵を取り出し、夜神月の手錠を外すと、湯気の立つ白いタオルを渡した。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_dabe7944:

    # "L并不担心夜神月会逃走——他脚上的镣铐不解除，人就只能像僵尸一样蹦跳，并且极易失去平衡。"
    "Lは夜神月が逃げることを心配していなかった——足首の束縛が解除されない限り、彼はゾンビのように跳ねるしかなく、極めてバランスを崩しやすいからだ。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_2f1ea4f1:

    # "夜神月沉默地接过毛巾擦手，动作优雅地开始用餐。"
    "夜神月は黙ってタオルを受け取り手を拭うと、食事を始めた。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_a03519fe:

    # "他用餐的速度不疾不徐，目光沉静，双手平稳，没有丝毫颤抖。"
    "彼の食事の速度は速からず遅からず、視線は静かで、両手は微動だにせず、震えは一切なかった。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_2ff12bfb:

    # "L见过太多在死前最后一餐饭时痛哭流涕者，大声咒骂者，绝望禁食者，暴饮暴食者……"
    "Lは死の直前の『最後の食事』で号泣する者、大声で罵る者、絶望して絶食する者、やけ食いする者……それを数多く見てきた。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_445b20e3:

    # "当然也有和夜神月一样以平常心用餐的，但是非常少。"
    "もちろん、夜神月のように平常心で食事を取る者もいたが、非常に稀だった。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_ead25c01:

    # "其中，{color=#ff0000}夜神月的罪行是最重的，杀过的人也是最多的{/color}。"
    "その中でも、{color=#ff0000}夜神月の罪状は最も重く、殺した人間も最多だった{/color}。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_bfcc30ca:

    # "用餐时，两个人都没有说话，夜神月将L充满兴趣的视线视作空气，平静地吃完了这不知道有没有下一顿的餐食。"
    "食事中、二人は一言も交わさなかった。夜神月はLの興味津々な視線を空気のように無視し、次があるかどうかもわからない食事を平静に食べ終えた。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_45018197:

    # "当他停筷时，剩余的料理还相当多。不过这也正常，为了观察对方的喜好，L拿了两人份的食物。"
    "彼が箸を止めた時、料理はまだかなり残っていた。しかし、それは当然のことだった。相手の好みを観察するため、Lは二人前の食物を持ってきたのだから。"

# game/script/daily_feed.rpy:252
translate japanese food_h1_ff55bb9b:

    # "重新戴好手铐后，夜神月开口了。"
    "手錠をかけ直した後、夜神月が口を開いた。"

# game/script/daily_feed.rpy:271
translate japanese food_h1_86e9d1f9:

    # Y "谢谢招待。所以，你是有求于我吗？"
    Y "ご馳走様。で、僕に何か用があるのか？"

# game/script/daily_feed.rpy:273
translate japanese food_h1_2c1b4578:

    # "夜神月的目光直视过来，非常锐利。"
    "夜神月の視線は真っ直ぐに向けられ、非常に鋭い。"

# game/script/daily_feed.rpy:279
translate japanese food_h1_74421c6c:

    # L "我只是想招待夜神君吃一顿饭而已，没有额外的用意哦。"
    L "私はただ夜神くんに食事を提供しただけです。それ以上の意図はありません。"

# game/script/daily_feed.rpy:281
translate japanese food_h1_0d41c4c1:

    # "夜神月露出一个讥讽的笑容，似乎在嘲笑你的虚伪。"
    "夜神月は嘲笑うような笑みを浮かべ、Lの偽善を嘲笑っているようだった。"

# game/script/daily_feed.rpy:283
translate japanese food_h1_11c20bda:

    # Y smile2 "谢谢，请回吧。"
    Y smile2 "それはどうも。早く帰れよ。"

# game/script/daily_feed.rpy:285
translate japanese food_h1_29aa204a:

    # "夜神月重新闭上了眼睛，做出逐客的姿态。"
    "夜神月は再び目を閉じ、客を追い払うような姿勢を見せる。"

# game/script/daily_feed.rpy:287
translate japanese food_h1_2bd0a96b:

    # "L收拾好餐盘，推着餐车离开了。"
    "Lは食器を片付け、ワゴンを押して去っていった。"

# game/script/daily_feed.rpy:295
translate japanese food_h1_5cfe2b74:

    # L "我确实有些话想和夜神君聊聊。"
    L "確かに、夜神くんと話したいことがいくつかあります。"

# game/script/daily_feed.rpy:297
translate japanese food_h1_39b6d477:

    # Y "事先声明，关于死亡笔记和死神的事情，我已经没有可以告诉你的了。"
    Y "言っておくが、デスノートや死神について、もうお前に話せることは何もない。"

# game/script/daily_feed.rpy:299
translate japanese food_h1_8b1f7cb5:

    # L "我知道，我想和夜神君说的不是这个。"
    L "承知しています。私が夜神くんに話したいのはそれではありません。"

# game/script/daily_feed.rpy:301
translate japanese food_h1_d43fc42f:

    # L order1 "夜神月，你不会死。"
    L order1 "夜神月、あなたは死なない。"

# game/script/daily_feed.rpy:302
translate japanese food_h1_53d868d6:

    # Y fadai "什么？"
    Y fadai "何だって？"

# game/script/daily_feed.rpy:305
translate japanese food_h1_3971e1ae:

    # "夜神月眨了眨眼睛，第一时间没有听懂这句话的意思。"
    "夜神月はまばたきをし、一瞬この言葉の意味を理解できなかった。"

# game/script/daily_feed.rpy:305
translate japanese food_h1_a0ad90bc:

    # "但是第二秒，巨大的荒谬感席卷而来。"
    "しかし次の瞬間、途方もない馬鹿馬鹿しさが押し寄せてきた。"

# game/script/daily_feed.rpy:305
translate japanese food_h1_1706bd7a:

    # "这个公开宣言要把Kira送上死刑台的侦探，L，说自己不会死？"
    "キラを死刑台に送ると公言していた探偵、Lが、まさか自分は死なないと口にするなんて。"

# game/script/daily_feed.rpy:305
translate japanese food_h1_4c011307:

    # "对公众怎么交代？法庭呢？公安部门呢？知道Kira真实身份和死神的所有人不会反对吗？他在干什么？他想干什么？"
    "世間にはどう説明する？裁判所は？公安は？キラの正体と死神を知る全員が反対しないのか？あいつは何をしている？何がしたい？"

# game/script/daily_feed.rpy:305
translate japanese food_h1_61b71b22:

    # "无数的疑问充满夜神月的大脑，让他一时间说不出话。"
    "無数の疑問が夜神月の脳裏を駆け巡り、彼はしばらく言葉が出せなかった。"

# game/script/daily_feed.rpy:305
translate japanese food_h1_65417ca5:

    # "数秒后，夜神月才艰涩地说出一个问句。"
    "数秒後、ようやく夜神月は渋い声で問いかけた。"

# game/script/daily_feed.rpy:319
translate japanese food_h1_902f1dc7:

    # Y renzhen "你是什么意思，龙崎？"
    Y renzhen "どういう意味だ、竜崎？"

# game/script/daily_feed.rpy:321
translate japanese food_h1_c563afc5:

    # L "就是字面意思，你不会被执行注射死刑，从此也没有社会上的身份，从此在这里活着。"
    L "文字通りの意味です。あなたに死刑は執行されません。社会的な身分を失い、これからはここで生きていくことになります。"

# game/script/daily_feed.rpy:323
translate japanese food_h1_25a8f311:

    # "夜神月看着你的眼神像看着一个疯子。"
    "夜神月は狂人を見るような眼差しでLを見た。"

# game/script/daily_feed.rpy:325
translate japanese food_h1_d2bb5ad3:

    # Y "这对你有什么好处？你想让我干什么？"
    Y "それでお前にどんな利益が？僕に何をさせたいんだ？"

# game/script/daily_feed.rpy:327
translate japanese food_h1_398d1a94:

    # "L开始不自觉地啃着指甲。"
    "Lは無意識に爪を噛み始めた。"

# game/script/daily_feed.rpy:329
translate japanese food_h1_6009d9b4:

    # L order2 "硬要说……只是一种直觉。"
    L order2 "強いて言うなら…単なる直感です。"

# game/script/daily_feed.rpy:331
translate japanese food_h1_1a5e9650:

    # L order2 "夜神君死掉的话就太可惜了。仅此而已。"
    L order2 "夜神くんが死ぬのはあまりに惜しい。それだけのことです。"

# game/script/daily_feed.rpy:333
translate japanese food_h1_8c17c4b4:

    # Y Light "（就因为这么简单的理由？真是胆大包天的人。）"
    Y Light "（そんな単純な理由で？ずいぶんと大胆なやつだな）"

# game/script/daily_feed.rpy:335
translate japanese food_h1_26cfd59b:

    # Y "不管怎样，这是你单方面做的事情。如果想以此要挟我做什么违背我意愿的事情，趁早死了心吧。"
    Y "どんな理由にしろ、これはおまえが一方的にやっていることだ。これで僕の意志に反することをさせようと思うなら、さっさと諦めたほうがいい。"

# game/script/daily_feed.rpy:337
translate japanese food_h1_b39af1d3:

    # "夜神月的表情相当冷淡。"
    "夜神月の表情はかなり冷淡だった。"

# game/script/daily_feed.rpy:339
translate japanese food_h1_81b828a6:

    # "你也没想过夜神月会因此对你感激涕零，不过这才符合他的性格，不是吗？"
    "夜神月が感謝するなど想定していない。それでこそ、夜神月らしいと言える。"

# game/script/daily_feed.rpy:341
translate japanese food_h1_a154c88d:

    # L "没关系，夜神君，我们来日方长。"
    L "構いませんよ、夜神くん。私たちには時間がたっぷりありますから。"

# game/script/daily_feed.rpy:343
translate japanese food_h1_a0a44fb1:

    # "留下别有深意的一句话，L推着餐车离开了囚室。"
    "意味深な一言を残すと、Lはワゴンを押して牢獄を後にした。"

# game/script/daily_feed.rpy:358
translate japanese food_h2_91355188:

    # "L端着托盘走入了囚室，托盘上承着一只精巧的黑色漆盒，盒身边缘甚至嵌着精美的金丝。"
    "Lはトレイを手に独房に入ってきた。トレイの上には精巧な黒漆塗りの箱が載っており、箱の縁には精美な金の象嵌が施されていた。"

# game/script/daily_feed.rpy:358
translate japanese food_h2_34ee3220:

    # "打开盒盖后，浓郁的油脂气息扑面而来。"
    "蓋を開けると、濃厚な脂の香りが鼻をついた。"

# game/script/daily_feed.rpy:358
translate japanese food_h2_2541300c:

    # "两片浸润着酱汁的鳗鱼铺在颗粒饱满、晶润透亮的米饭上，鱼皮被炙烤到表面微焦边缘酥脆，再用筷子微微一划便能将软嫩的鱼肉完全分开。"
    "タレに漬け込まれた大きな鰻の二切れが、つやつやと輝くふっくらした米飯の上に敷かれている。皮は香ばしく炙られて縁がパリッとし、箸を軽く入れるだけで柔らかな身がほろりとほどけそうだ。"

# game/script/daily_feed.rpy:358
translate japanese food_h2_0e48b23f:

    # "焦香的酱汁顺着缝隙渗入米饭，托盘上甚至还贴心地摆着供人研磨的山葵和罐装的七味粉。"
    "香ばしいタレが切れ目からご飯に染み込み、トレイには使いやすいようにワサビと瓶入りの山椒まで添えられていた。"

# game/script/daily_feed.rpy:358
translate japanese food_h2_a5fcad96:

    # "月明显被食物的香气吸引了，他的目光看向L，头略微抬起。"
    "月は明らかに食べ物の香りに惹かれたようで、視線をLに向け、わずかに頭を持ち上げる。"

# game/script/daily_feed.rpy:371
translate japanese food_h2_921f6937:

    # Y "可以让我自己吃吗？"
    Y "自分で食べさせてくれないか？"

# game/script/daily_feed.rpy:379
translate japanese food_h2_fd8c0558:

    # "L似乎没有解开月手铐的意思，他抓起一旁放置的银勺，插入鳗鱼饭底部挖起一勺米饭送到了月的嘴边。"
    "Lは月の手錠を外す気はないようだった。Lは傍らに置かれた銀のスプーンを掴み、鰻丼の底からご飯を一口すくい、月の口元に運ぶ。"

# game/script/daily_feed.rpy:379
translate japanese food_h2_abf0ff42:

    # "鱼肉因为L粗糙的举动散了开来，酥脆的鱼皮也被留在了盒内。"
    "Lの乱雑な扱いで魚の身は崩れ、香ばしい皮が重箱の中に取り残されてしまった。"

# game/script/daily_feed.rpy:383
translate japanese food_h2_31120b2d:

    # L smile1 "今天特意准备了和食，夜神君请用吧。"
    L smile1 "本日は特に和食を用意しました。どうぞ、夜神くん。"

# game/script/daily_feed.rpy:385
translate japanese food_h2_fc48440c:

    # "月没有接话，乖顺地吃掉了第一口。"
    "月は返答せず、おとなしく一口目を食べた。"

# game/script/daily_feed.rpy:385
translate japanese food_h2_6d3a6ebd:

    # "鳗鱼入口即化，微甜的酱汁回味浓香，配着上乘的大米味道属实不错。"
    "鰻は口に入れるとすぐにとろけ、ほんのり甘いタレの余韻が濃厚に香り、上質な米と合わせると実に美味だった。"

# game/script/daily_feed.rpy:385
translate japanese food_h2_a89e2e0b:

    # "第一口下肚后，月反复扫视了几眼漆盒里剩下的鱼皮，不断对L流露出“你真是暴殄天物”的眼神。"
    "一口食べ終わると、月は重箱に残された皮を何度か睨みつけ、Lに「本当に勿体ないことをする奴だ」という眼差しを向け続けた。"

# game/script/daily_feed.rpy:391
translate japanese food_h2_a3058d05:

    # L surprise "夜神君想吃鱼皮吗？"
    L surprise "夜神くん、皮が食べたいのですか？"

# game/script/daily_feed.rpy:393
translate japanese food_h2_9a160f9e:

    # Y "并没有，我已经很饿了，可以吃第二口吗？"
    Y "別に。それより腹が減っているんだ、二口目も食べていいか？"

# game/script/daily_feed.rpy:395
translate japanese food_h2_db09a151:

    # "L捧起装着盒子的鳗鱼饭，舀起第二口喂到月的嘴边。"
    "Lは鰻丼の重箱を持ち上げ、二口目をすくって月の口元に運んだ。"

# game/script/daily_feed.rpy:395
translate japanese food_h2_b56f033a:

    # "鱼皮带着韧性难以切断，所以L只是简单地把鳗鱼肉从鱼皮上刮了下来、和米饭拌在一起完成了一次的喂食。"
    "皮は弾力があって切り離しにくかったので、Lは鰻の身だけを皮から削ぎ取り、ご飯と混ぜ合わせて一口分を用意する。"

# game/script/daily_feed.rpy:395
translate japanese food_h2_61795c65:

    # "L注视着月咽下第二口，有些多余的酱汁沾到了床单上，在他拿出纸巾清理的时候，L注意到月的眼神还是不时停留在盒内的鳗鱼皮上。"
    "Lは月が二口目を飲み込むのを見つめていた。少しタレがシーツに付着したので、ティッシュで拭き取っていると、Lは月の視線が未だに箱の中の鰻の皮に留まっていることに気づいた。"

# game/script/daily_feed.rpy:401
translate japanese food_h2_f18e996e:

    # L smile2 "果然，夜神君还是想吃的吧。"
    L smile2 "やはり、夜神くん、皮が食べたいのでしょう。"

# game/script/daily_feed.rpy:403
translate japanese food_h2_fc025ef0:

    # Y "……"
    Y "……"

# game/script/daily_feed.rpy:405
translate japanese food_h2_dce5d791:

    # L smile1 "既然这样的话，不喂给夜神君反倒是我的不对了。"
    L smile1 "そうなると、夜神くんに食べさせない方が私の落ち度になってしまいますね。"

# game/script/daily_feed.rpy:407
translate japanese food_h2_4d16e40a:

    # "L暂时放下了盒子，将木质的一次性筷子掰开，用筷尖划开鱼肉、分开鱼皮切出完整的一小块鳗鱼，"
    "Lは一旦重箱を下ろし、割り箸を割ると、箸先で身を切り分け、皮からきれいな一小切れの鰻を取り分けた。"

# game/script/daily_feed.rpy:407
translate japanese food_h2_5102b03a:

    # "又用勺子舀了满满一勺被酱汁浸润的米饭，把那块形状漂亮的鳗鱼放到米饭上，缓缓将勺子递到月嘴边。"
    "さらにスプーンでタレに染み込んだご飯をたっぷりすくい、その形の良い鰻を載せると、ゆっくりと月の口元にスプーンを差し出した。"

# game/script/daily_feed.rpy:411
translate japanese food_h2_2486ed56:

    # L "好了，这口是夜神君喜欢的样子了。"
    L "さあ、これで夜神くんのお好み通りです。"

# game/script/daily_feed.rpy:413
translate japanese food_h2_ca512ee5:

    # "月对L轻慢的措辞露出了愤怒的神情，他皱着眉怒视着L，如果不是有手铐的话、月一定会和监禁时期一样揍人吧？"
    "月はLの軽慢な言い方に怒りの表情を浮かべ、眉をひそめてLを睨みつけた。もし手錠がなければ、監禁されていた時のようにきっと殴りかかっていただろう。"

# game/script/daily_feed.rpy:413
translate japanese food_h2_15180518:

    # "但是在饥饿感的驱使下，这种怒意只维持了几秒，月闭上眼，似乎是下定了很大的决心张开嘴，把勺子含入嘴中吃下了那口饭。"
    "しかし空腹感に駆られ、この怒りは数秒しか続かなかった。月は目を閉じ、大きな決心をしたように口を開き、スプーンを口に含んでその一口を食べた。"

# game/script/daily_feed.rpy:413
translate japanese food_h2_c7c9c82e:

    # "和鱼肉绵软的口感不同，牙齿咬下后能轻易感受到鱼皮边缘的酥脆，多次咀嚼后炭火浓厚的香气便混着鳗鱼皮胶质满满的筋道口感一块充斥着口腔。"
    "ほろりと柔らかな身とは対照的に、歯を立てると皮の縁は軽やかに香ばしく弾ける。何度も咀嚼するうちに、炭火の濃厚な香りが鰻皮のゼラチン質で弾力ある歯ごたえと共に口いっぱいに広がった。"

# game/script/daily_feed.rpy:413
translate japanese food_h2_61b1eabe:

    # "接下来就只是重复切割鱼肉、舀起米饭，组装一个“小型鳗鱼饭”，然后喂给月的重复过程。"
    "その後は、身を切り分け、ご飯をすくい、「ミニ鰻丼」を組み立て、月に食べさせるという過程の繰り返しだった。"

# game/script/daily_feed.rpy:413
translate japanese food_h2_6c2b8cf3:

    # "在盒子差不多见底的时候，月挪动了一下身子，重新和L拉开了一点距离。"
    "箱がほぼ空になった頃、月は体を少し動かし、再びLと距離を取った。"

# game/script/daily_feed.rpy:423
translate japanese food_h2_1a8cf9a3:

    # Y "我吃饱了。"
    Y "もう十分だ。"

# game/script/daily_feed.rpy:425
translate japanese food_h2_eeefa350:

    # "L闻言停止了喂食的举动，将勺子和筷子放进已经空了的漆盒内，用湿巾简单擦试了一下月嘴边残留的酱汁，最后端着餐具离开了囚室。"
    "Lはその言葉を聞くと給餌の動作を止め、スプーンと箸を空になった重箱に入れた。ウェットティッシュで月の口元に残ったタレをさっと拭うと、最後に食器を持って牢獄を後にした。"

# game/script/daily_feed.rpy:429
translate japanese food_h2_f28f074e:

    # "L把托盘放在一旁，用钥匙帮月解开了拷在背后的双手。"
    "Lはトレイを傍らに置き、鍵で月の背後で拘束されていた両手の手錠を外した。"

# game/script/daily_feed.rpy:429
translate japanese food_h2_0230dd2a:

    # "月活动了下因长时间束缚而有些酸痛的手腕，他抬眼看了看托盘上的食物，对L询问道。"
    "月は長時間の拘束で少し痛んだ手首を動かし、トレイの上の食べ物を見上げながらLに尋ねた。"

# game/script/daily_feed.rpy:436
translate japanese food_h2_96b30bf3:

    # Y "今天是让我自己进食么？"
    Y "今日は自分で食べさせてくれるのか？"

# game/script/daily_feed.rpy:437
translate japanese food_h2_351d80a0:

    # L smile1 "是的。感觉夜神君更想自己动手吃鳗鱼饭的样子。"
    L smile1 "はい。夜神君が自分で鰻丼を食べたいようでしたので。"

# game/script/daily_feed.rpy:438
translate japanese food_h2_eebb2a76:

    # "L体贴地拿起托盘上承放的热毛巾，确认温度正好后递给了月。"
    "Lは気遣ってトレイの上に置かれた温かいタオルを取り、温度が丁度良いことを確認して月に渡した。"

# game/script/daily_feed.rpy:439
translate japanese food_h2_5ea7636e:

    # L pt "请用。"
    L pt "どうぞ。"

# game/script/daily_feed.rpy:440
translate japanese food_h2_e041ed51:

    # Y "……谢谢。"
    Y "……どうも。"

# game/script/daily_feed.rpy:441
translate japanese food_h2_9f062bf6:

    # "月接过毛巾简单擦拭了一下面部和双手，随后托起漆盒底部、用筷子规整地分开鱼肉，稍稍用力划开鱼皮，将鱼皮和鱼肉连着米饭一同舀起送入了口腔。"
    "月はタオルを受け取り、顔と両手を簡単に拭うと、重箱の底を支え、箸で身をきれいに分け、少し力を入れて皮を切り、皮と身をご飯とともにすくって口に運んだ。"

# game/script/daily_feed.rpy:441
translate japanese food_h2_c7c9c82e_1:

    # "和鱼肉绵软的口感不同，牙齿咬下后能轻易感受到鱼皮边缘的酥脆，多次咀嚼后炭火浓厚的香气便混着鳗鱼皮胶质满满的筋道口感一块充斥着口腔。"
    "ほろりと柔らかな身とは対照的に、歯を立てると皮の縁は軽やかに香ばしく弾ける。何度も咀嚼するうちに、炭火の濃厚な香りが鰻皮のゼラチン質で弾力ある歯ごたえと共に口いっぱいに広がった。"

# game/script/daily_feed.rpy:447
translate japanese food_h2_d09470eb:

    # L smile1 "渡说这家鳗鱼饭在都内算热门店铺，我特意给夜神君预定了最好的套餐呢。"
    L smile1 "ワタリが、この鰻重の店は都内でも人気店だと言っていました。特別に夜神くんのため、一番良いコースを予約しました。"

# game/script/daily_feed.rpy:448
translate japanese food_h2_e140efe7:

    # L "夜神君吃得还满意吗？"
    L "夜神くん、口に合いましたか？"

# game/script/daily_feed.rpy:449
translate japanese food_h2_670f3436:

    # "坦白来说，这确实是月有生以来吃过最美味的一次鳗鱼饭。"
    "率直に言って、これは月が生まれて以来食べた中で最も美味しい鰻丼だった。"

# game/script/daily_feed.rpy:449
translate japanese food_h2_8001615b:

    # "不论是鱼肉回弹的质感还是恰到好处的酱汁调味，配上口感极佳的米饭绝对算得上美味佳肴。"
    "弾むような皮の歯ごたえも、絶妙に調えられたタレの味わいも、上質な米と合わさることでまさに極上の一品となっていた。
"

# game/script/daily_feed.rpy:449
translate japanese food_h2_820b133b:

    # "月回味着鳗鱼肉在口腔内残存的质感，拿起一旁的毛巾擦拭了一下沾到嘴边的酱汁。"
    "月は口中に残る鰻の食感を噛みしめながら、傍らのタオルを取り、口元に付いたタレを拭った。"

# game/script/daily_feed.rpy:454
translate japanese food_h2_7feb83e1:

    # Y smile1 "能吃出来用了很好的食材，的确是很不错的一餐。"
    Y smile1 "いい素材を使ってるのは分かる……確かに、とてもいい食事だったよ。"

# game/script/daily_feed.rpy:455
translate japanese food_h2_d74b5953:

    # "L笑了，似乎是对月的回答很满意，他屈起膝盖蹲在床侧，歪着脑袋继续观察棕发青年的进食行为。"
    "Lは笑みを浮かべ、月の答えにとても満足した様子だった。彼は膝を折ってベッドのそばにしゃがみ込み、首をかしげながら、栗色の髪の青年の食事の様子を観察し続けた。"

# game/script/daily_feed.rpy:456
translate japanese food_h2_96445b23:

    # L smile1 "那真是太好了，夜神君请继续吧。"
    L smile1 "それは何よりです。どうぞそのまま続けてください、夜神くん。"

# game/script/daily_feed.rpy:459
translate japanese food_h2_fb87214e:

    # "美味的鳗鱼饭充分勾起了月的食欲，他很快舀起下一口放入口中，快速消灭起盒内的食物。"
    "美味しい鰻丼は月の食欲を充分にかき立てたらしい。彼はすぐに次の一口をすくって口に運び、箱の中の食物を素早く平らげ始めた。"

# game/script/daily_feed.rpy:459
translate japanese food_h2_2c561cdd:

    # "大约吃到一半时月停下了动作，转而将目光投向承放着山葵的研磨器。"
    "半分ほど食べた頃、月は動作を止め、わさびとおろし器が置かれた方へ視線を移した。"

# game/script/daily_feed.rpy:459
translate japanese food_h2_b476b158:

    # "他握住山葵的尾部，在研磨板上前后摩擦起来，随后用筷尖挑起一小撮淡绿色的山葵泥放在鳗鱼上，"
    "月はワサビの根元を握り、すり板の上で前後に擦りおろす。そして箸先で淡い緑色のワサビをすくい取り、鰻の上に載せた。"

# game/script/daily_feed.rpy:459
translate japanese food_h2_90c30cfa:

    # "些微的辛辣感缓解了脂肪的油腻，更让人食欲大增、一筷子接一筷子地大快朵颐起来。"
    "わずかな辛味が脂っこさを和らげ、食欲がさらに増し、次から次へと箸が進んだ。"

# game/script/daily_feed.rpy:459
translate japanese food_h2_aff601c7:

    # "月很快吃完了这一餐，在完食后将餐具整齐地叠放在托盘上，重新向床铺内侧挪动了一点、拉开和L的距离。"
    "月はすぐに食事を平らげ、器をきちんと重ねてトレイに戻した。食後、そっとベッドの奥へ身を移し、Lとの間合いを広げる。"

# game/script/daily_feed.rpy:469
translate japanese food_h2_1a8cf9a3_1:

    # Y "我吃饱了。"
    Y "もう十分満足だ。"

# game/script/daily_feed.rpy:471
translate japanese food_h2_16b003f4:

    # "L闻言端起了托盘，将筷子和剩余的山葵放进已经空了的漆盒内，最后重新帮月拷好手铐、检查没有任何疏忽后端着托盘离开了囚室。"
    "Lはその言葉を受けてトレイを手に取り、箸と残っていたワサビを空になった重箱へ戻した。月に改めて手錠を掛け、念入りに確認して抜かりがないことを確かめると、トレイを抱えて牢獄を出て行った。"

# game/script/daily_feed.rpy:476
translate japanese food_h3_b0349067:

    # "L进入囚室时带着一辆三层的金属制推车，每一层都摆放着由两个不锈钢圆盖仔细罩住的银制托盘，从缝隙中隐隐传出烘焙的香气。"
    "Lが牢獄に入ってきた時、三段式の金属製のカートを押していた。各段には二つのステンレス製のドームで丁寧に覆われた銀製のトレイが置かれており、隙間からはかすかに香ばしい匂いが漂っていた。"

# game/script/daily_feed.rpy:476
translate japanese food_h3_aacc52d3:

    # "L将推车送到月的床铺前、缓缓打开第一层的两个圆盖："
    "Lはカートを月のベッドの前に移動させ、ゆっくりと一段目の二つのドームを開けた："

# game/script/daily_feed.rpy:482
translate japanese food_h3_a3190830:

    # "左边是一只手掌大小的藤编筐，里面薄薄垫了层烘焙纸，承着外壳酥脆的圆面包和几片切好的法棍；"
    "左側には手のひらほどの大きさの籐編みのカゴがあった。中には薄くベーキングペーパーが敷かれ、中には香ばしい丸パンと、数枚に切り分けられたバゲットが載せられていた。"

# game/script/daily_feed.rpy:482
translate japanese food_h3_e7b8bef6:

    # "右边摆放着一片柳叶形的瓷器，颜色各异的复合口味黄油呈橄榄形依次在位，瓷盘的最右边码放着一把雕工精美的银制黄油刀。"
    "右側には柳の葉の形をした陶器が置かれ、さまざまな風味のバターがオリーブ形に整えられて順々に並んでいる。皿の端には、彫刻が施された銀のバターナイフが上品に添えられていた。"

# game/script/daily_feed.rpy:482
translate japanese food_h3_2b308ba7:

    # "L将两个圆盖收好，展开餐巾铺到月的腿上，随后站在推车后面像个尽职尽责的侍者一样向月介绍起复合黄油的味道。"
    "Lは二つのドームを片付け、ナプキンを広げて月の膝の上に置くと、カートの後ろに立ち、誠実な給仕人のように月にバターの味を説明し始めた。"

# game/script/daily_feed.rpy:488
translate japanese food_h3_012c2728:

    # L smile1 "从左边开始分别是绿色的罗勒开心果黄油、棕色的咸味增黄油、以及混合了辣椒与龙虾膏的红色黄油。"
    L smile1 "左から順に、緑のバジルピスタチオバター、茶色の塩味噌バター、そして唐辛子とロブスターエキスを混ぜた赤いバターです。"

# game/script/daily_feed.rpy:488
translate japanese food_h3_58390a47:

    # L smile1 "不管哪一种都很适合搭配餐前面包，是经典的法餐开局呢。"
    L smile1 "どれも前菜のパンとの相性が良く、 クラシックなフランス料理の始まり方です。"

# game/script/daily_feed.rpy:497
translate japanese food_h3_b81f0047:

    # "L从面包筐中取出一只圆面包，随意撕下一角后用黄油刀抹上了绿色的开心果黄油递到月的嘴边。"
    "Lはパンかごから丸パンを一つ取り出し、適当に一口大にちぎると、バターナイフで緑のピスタチオバターを塗り、月の口元に差し出した。"

# game/script/daily_feed.rpy:497
translate japanese food_h3_06ece022:

    # "月在咀嚼时吃到了罗勒独有的草本香气，和开心果油润的口感相性拔群，即使他有些讨厌L拿着面包喂食自己的行为，还是努力地将食物吞下了肚子。"
    "噛むたびに広がるバジル特有の爽やかな香りと、ピスタチオのまろやかな口当たりが絶妙に調和する。Lにパンを食べさせられるのは不快だったが、月はそれでも堪えて食べ物を飲み込んだ。"

# game/script/daily_feed.rpy:497
translate japanese food_h3_89eeb971:

    # "在沾有黄油部分的面包全部吃完后，月很快停下了进食的动作。"
    "バターの付いた部分を全て食べ終わると、月は食事の動作を止めた。"

# game/script/daily_feed.rpy:503
translate japanese food_h3_58e1dc7c:

    # L surprise "怎么了夜神君，这些食物就够么？"
    L surprise "どうしました夜神くん、このくらいの量で十分ですか？"

# game/script/daily_feed.rpy:504
translate japanese food_h3_944c7b23:

    # Y "……只吃面包太干了，我还想尝尝别的口味的黄油。"
    Y "……パンだけじゃパサつく。他の味のバターも試してみたい。"

# game/script/daily_feed.rpy:505
translate japanese food_h3_f992cec2:

    # Y "而且刚刚吃的那个味道还蛮不错的，我想再来一点。"
    Y "それに、さっき食べたバターはなかなか良かったから、もう少し欲しい。"

# game/script/daily_feed.rpy:507
translate japanese food_h3_5258c49a:

    # "月计算着面包剩余的数量，在心里谋划着应当如何享用这次的餐食。"
    "月は残りのパンの量を計算しながら、今回の食事をどう楽しむべきか心中で計画していた。"

# game/script/daily_feed.rpy:507
translate japanese food_h3_271e7f10:

    # "今天L送来的餐点质量很高，现在还只是餐前面包、而餐车足足堆满了三层。"
    "今日Lが持ってきた食事の質は高く、今はまだ前菜のパンの段階で、カートは三段すべて積まれている。"

# game/script/daily_feed.rpy:507
translate japanese food_h3_ae4cd295:

    # "从餐车堆放的碗碟推算，恐怕所有菜肴的数量加起来都不亚于一顿正式的西餐。"
    "カートに積まれた皿の数から推測すると、すべての料理を合わせれば正式な西洋料理のコースに匹敵する量だろう。"

# game/script/daily_feed.rpy:513
translate japanese food_h3_e7df9dc4:

    # L smile3 "我知道了，夜神君请用吧。"
    L smile3 "わかりました。夜神くん、どうぞ。"

# game/script/daily_feed.rpy:515
translate japanese food_h3_4c399535:

    # "L用餐刀重新为面包补上了一点黄油喂给月，而后撕下第二块面包，在月咀嚼完食物的时候恰到好处地将下一口递到月的嘴边。"
    "Lはバターナイフでパンに再度バターを塗り月に食べさせると、二切れ目のパンをちぎり、月が食物を噛み終わる頃合いに次の一口を口元に運んだ。"

# game/script/daily_feed.rpy:515
translate japanese food_h3_491319ed:

    # "第二款棕色的黄油入口还带着些许甜味，月很快吃到了味增的酱香，红糖很好勾勒出黄油丰盈的口感，熟悉的家乡风味让月甚至怀念过往母亲为家人做的简餐。"
    "二つ目の茶色いバターは、口に含んだ瞬間ほんのり甘く、すぐに味噌の芳醇な香りが広がった。黒糖がバターのコクを引き立て、馴染み深い味噌の風味が、母が家族に作ってくれたいつもの食卓の記憶を呼び起こした。"

# game/script/daily_feed.rpy:519
translate japanese food_h3_d772dade:

    # Y smile1 "很好吃呢。可以帮我再抹一点黄油吗？"
    Y smile1 "美味いな。もう少しバターを塗ってくれないか？"

# game/script/daily_feed.rpy:521
translate japanese food_h3_07e1f60c:

    # "L惊讶于月的坦诚，一时间停下了手中的动作。"
    "Lは月の率直さに驚き、一瞬手の動きを止めた。"

# game/script/daily_feed.rpy:521
translate japanese food_h3_1e1aed16:

    # "他和夜神月的对话很少没有硝烟味，狭小的囚室总会催生月的负面情绪，让月回呛他的每一句话。"
    "Lと夜神月の会話はほとんど火花を散らすものばかりだった。狭い牢獄は常に月の負の感情をかき立て、月はLの一言一言に反論してきた。"

# game/script/daily_feed.rpy:521
translate japanese food_h3_e8393ee9:

    # "但L将月难得的妥协归功于餐品的美味，并乐得靠喂食的行动缓和下自己和月之间的气氛———毕竟没有人会和食物过不去不是么。"
    "しかしLは、月の珍しい妥協を料理の美味しさのおかげだと考え、食べさせるという行為で自分と月の間の雰囲気を和らげることを喜んでいた―――結局のところ、誰も食べ物に逆らうことはないらしい。"

# game/script/daily_feed.rpy:521
translate japanese food_h3_e03cead6:

    # "在第二块黄油消灭殆尽后，L在面包的截面涂上了混有龙虾膏的辣味黄油，月浅尝了一口后便摇着头拒绝了L递来的下一块面包。"
    "二つ目のバターが無くなった後、Lはパンの断面にロブスターエキス入りのスパイシーバターを塗った。だが、月は一口味見した後、首を振ってLが差し出した次のパンを断った。"

# game/script/daily_feed.rpy:529
translate japanese food_h3_ef4d1e40:

    # Y han "……太辣了，吃不了。"
    Y han "……辛すぎる、食べられない。"

# game/script/daily_feed.rpy:530
translate japanese food_h3_53288ef1:

    # L order2 "是这样啊，看来夜神君不擅长应对辣椒呢。"
    L order2 "そうですか、夜神くんは唐辛子が苦手なようですね。"

# game/script/daily_feed.rpy:532
translate japanese food_h3_949853d8:

    # "L一边回话一边揭开了下一层的圆盖，月瞧见两只碟碗，"
    "Lは返事をしながら次の段のドームを開け、月は二つの皿を見た。"

# game/script/daily_feed.rpy:532
translate japanese food_h3_52867d61:

    # "一碗盛着由应季蔬果、白煮蛋和些许面包干拌好的小份沙拉，一碗则是清澈见底、能闻到些许香气的法式清汤。"
    "一方の器には、旬の野菜と果物にゆで卵と少量のクルトンを合わせた小ぶりのサラダ。もう一方には、透き通るほど澄んだフレンチ風のコンソメスープが注がれ、ほのかな香りが立ちのぼっていた。"

# game/script/daily_feed.rpy:540
translate japanese food_h3_ebc022c2:

    # "L绕到月的身后解开了他的手铐，将由另一条餐巾包裹着的刀叉递给月、并对月做出了请用的手势。"
    "Lは月の背後に回り手錠を外すと、ナプキンに包まれたナイフとフォークを差し出し、さあと促す仕草を見せた。"

# game/script/daily_feed.rpy:542
translate japanese food_h3_ee143b30:

    # L smile3 "今天的餐点更适合交给夜神君自己进食呢，请用吧。"
    L smile3 "今日の料理は夜神くんが自分で食べた方が良さそうです。どうぞ"

# game/script/daily_feed.rpy:544
translate japanese food_h3_13f152ba:

    # "青年早已被面包的香气吸引，虽然他很在意L一直盯着自己的眼睛———但月还是相当迫不及待地从筐里取出了那只圆面包。"
    "青年はすでにパンの香りに惹かれており、Lがじっと自分を見つめる目が気にはなったものの———月はかなり待ちきれない様子でかごから丸パンを取り出した。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_8e432d03:

    # "带着酥脆外壳的面包在掰开后露出内里细密柔软的气孔，月将面包分成四块，"
    "パリッとした皮を割ると、中からきめ細かく柔らかな気泡のある内層が現れた。月はそれを四等分にちぎる。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_f509f9f4:

    # "第一口没有选择搭配任何黄油，面包最为原始的麦香和咸味在口中扩散开来，直到月咽下后仍然留有浅淡的香气。"
    "最初のひと口はバターを添えずにそのまま。パンそのものの麦の香ばしさと塩味が口いっぱいに広がり、飲み込んだ後も淡い香りが余韻のように残った。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_8ed3cfc9:

    # "第二口月选择给面包抹上绿色的黄油，咀嚼时罗勒清新的草本味道混合着开心果浓厚的坚果香味充盈着鼻腔，油润的口感让月不禁撕下了更多的面包送入口中。"
    "二口目には緑のバターを塗って食べた。噛むごとにバジルの清々しい香りとピスタチオの濃厚なナッツの香ばしさが溶け合い、鼻いっぱいに広がる。まろやかな舌触りに惹かれ、月は思わずパンをちぎって次々と口に運んだ。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_706a277f:

    # "第三口是日本相当传统的味增口味，但添加的些许红糖更增加了黄油的层次感，"
    "三口目は日本らしい伝統的な味噌の風味。ただ少し加えられた黒糖が、バターの味わいに深みを添えていた。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_cbbb57b6:

    # "月偏爱这款黄油熟悉的家乡味道，甚至挪用了部分属于第三种黄油的面包份额用来配餐，直至黄油被刮了个精光。"
    "月はとくにこの味噌の風味を気に入ったらしい。三つ目のバター用に残していたパンまで使って楽しんだ。気づけば味噌バターは跡形もなくなくなっていた。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_0e616647:

    # "月似乎不擅长应付最后一款黄油的辣味，青年只是浅浅尝了味道后便没有再挖取新的一口，"
    "最後、月はどうやらバターの辛さが苦手らしく、ほんの少し口にしただけで、それ以上は手を伸ばそうとはしなかった。"

# game/script/daily_feed.rpy:544
translate japanese food_h3_626f1d74:

    # "而是将黄油刀放回瓷盘、拿起腿上放置的餐巾擦了擦嘴，相当乖顺地等待L为他揭开托盘第二层的秘密。"
    "バターナイフを皿に戻し、膝の上のナプキンで口元を軽く拭うと、月はおとなしく身を引き、Lがトレイの二段目を開けるのを待った。"

# game/script/daily_feed.rpy:560
translate japanese food_h3_5d19de9f:

    # L "夜神君看起来吃得很香，觉得味道怎么样？"
    L "夜神くん、とても美味しそうに食べていましたね。味はどうでしたか？"

# game/script/daily_feed.rpy:561
translate japanese food_h3_0b10c99c:

    # Y smile1 "我还是第一次吃到这种口味的复合黄油，味增口味的还挺适合拿来配面包的。"
    Y smile1 "こういう風味を掛け合わせたバターを食べるのは初めてだけど、味噌味は意外とパンと相性がいいな。"

# game/script/daily_feed.rpy:562
translate japanese food_h3_130a5ccc:

    # L "毕竟是六本木王道法餐的主推套餐嘛，本土化做得相当成功呢。"
    L "なにしろ六本木の王道フレンチの看板コースですからね。ローカライズはかなり成功しているようです。"

# game/script/daily_feed.rpy:564
translate japanese food_h3_949853d8_1:

    # "L一边回话一边揭开了下一层的圆盖，月瞧见两只碟碗，"
    "Lは返事をしながら次の段のドームを開け、月は二つの皿を見た。"

# game/script/daily_feed.rpy:564
translate japanese food_h3_52867d61_1:

    # "一碗盛着由应季蔬果、白煮蛋和些许面包干拌好的小份沙拉，一碗则是清澈见底、能闻到些许香气的法式清汤。"
    "一方の器には、旬の野菜と果物にゆで卵と少量のクルトンを合わせた小ぶりのサラダ。もう一方には、透き通るほど澄んだフレンチ風のコンソメスープが注がれ、ほのかな香りが立ちのぼっていた。"

# game/script/daily_feed.rpy:572
translate japanese food_h3_bf78f485:

    # "L简单地收拾了下餐前面包用到的餐具，随后将沙拉与清汤摆到了月的面前。"
    "Lは前菜のパンで使用した食器を簡単に片付け、その後サラダとコンソメスープを月の前に置いた。"

# game/script/daily_feed.rpy:572
translate japanese food_h3_6e1f22c8:

    # "沙拉里混合着应季的蔬菜和坚果，L舀起一勺沙拉靠近青年的嘴边时，月闻到了意大利香醋混合着蜂蜜的味道。"
    "サラダには旬の野菜とナッツが混ざっており、Lがスプーンですくって青年の口元に近づけると、バルサミコ酢と蜂蜜が混じり合った香りがふわりと鼻をくすぐった。"

# game/script/daily_feed.rpy:572
translate japanese food_h3_9f2ea3b0:

    # "酸甜的沙拉很好去除了刚才黄油面包的油腻，只是L翻拌沙拉的手法实在是太烂，喂过来的沙拉不是一点酱料都没有沾上、就是浸满了过酸的黑醋。"
    "酸味と甘味のあるサラダは、先ほどのバターを塗ったパンの脂っこさをうまく取り除いてくれた。だがLのサラダを混ぜる手際は本当にひどく、差し出されたサラダはドレッシングがまったくついていないか、あるいは酸っぱすぎるバルサミコ酢に浸りきっているかのどちらかだった。"

# game/script/daily_feed.rpy:572
translate japanese food_h3_71d18908:

    # "几口之后月便受不了这种交替着折磨味蕾的行为，出声制止了L的喂食。"
    "数口食べた後、月は味覚を交互に痛めつけるこの行為に耐えられなくなり、Lの手を制止した。"

# game/script/daily_feed.rpy:580
translate japanese food_h3_4bbc6e56:

    # Y "……已经可以了，龙崎可以换成清汤了。"
    Y "……もういい、竜崎、スープにかえてくれ。"

# game/script/daily_feed.rpy:581
translate japanese food_h3_67a942bf:

    # L surprise "夜神君讨厌吃蔬菜吗？为了健康起见我认为他还是多摄入一些维生素会比较好。"
    L surprise "夜神くんは野菜が嫌いですか？健康のためにもビタミンはもう少し摂取した方がいいと思いますが。"

# game/script/daily_feed.rpy:583
translate japanese food_h3_d54dc2fb:

    # "月有些无语地看着L，他回想起在搜查总部时L那不健康的嗜糖饮食，毫不犹豫地出声抗议道。"
    "月は呆れたようにLを見つめる。捜査本部にいたころのLの偏った甘味嗜好を思い出しながら、ためらいなく抗議の声を上げた。"

# game/script/daily_feed.rpy:585
translate japanese food_h3_f5f9119f:

    # Y "龙崎才应该多吃一点蔬菜吧？只吃甜品的话不论是心脏病还是糖尿病发病率都是常人的三倍以上。"
    Y "竜崎こそ、もっと野菜を食べるべきじゃないか？　甘いものばっかり食べていると、心臓病でも糖尿病でも発症率は普通の人の三倍以上だぞ。"

# game/script/daily_feed.rpy:586
translate japanese food_h3_a9a6eba5:

    # Y "当然，如果龙崎能这么轻易死掉的话我也不会在这里了吧。"
    Y "もちろん、竜崎がそんな簡単に死ぬなら、僕がここにいることもないだろうけどな。"

# game/script/daily_feed.rpy:588
translate japanese food_h3_5601d09b:

    # "L撇了撇嘴，他有些讨厌别人置喙自己的生活方式，"
    "Lは口をへの字に曲げる。他人に自分のライフスタイルをとやかく言われるのは少し嫌いだった。"

# game/script/daily_feed.rpy:588
translate japanese food_h3_a60cd891:

    # "但是面对已经在司法流程和自己私心下被二次关押超过两个月的夜神月，他承认作为上位者确实可以摆出一些宽容的姿态。"
    "しかし、司法手続きと自らの私情によってすでに二度目の監禁を二か月以上も受けている夜神月に対して、支配する側として多少の寛容な姿勢を示すことができる。"

# game/script/daily_feed.rpy:593
translate japanese food_h3_7478687d:

    # "L只当月在发泄不满，在帮月简单擦拭了嘴角残留的酱汁后，便将清汤端了过来。"
    "Lは月の言葉をただの不満の発散と受け止め、月の口元に残ったソースを簡単に拭った後、コンソメスープを手元に持ってきた。"

# game/script/daily_feed.rpy:593
translate japanese food_h3_a5060847:

    # "L放下沙拉的餐叉，转而捏住汤匙银色的握柄，在确认汤品的温度适宜后送入了月的嘴中。"
    "Lはサラダ用のフォークを置いて、代わりに銀色のスプーンを握る。スープの温度が適切であることを確認してから月の口に運んだ。"

# game/script/daily_feed.rpy:593
translate japanese food_h3_bbe5d0b9:

    # "蔬菜的甜美和肉类蛋白的复杂风味完全被锁在汤品中，使得咽下去后仍然回味生香，"
    "野菜の甘みと肉の持つ複雑な旨みがしっかりとスープに溶け込み、飲み込んだ後も香り高い余韻が口に残った。"

# game/script/daily_feed.rpy:593
translate japanese food_h3_90d19b38:

    # "碗中盛放的欧芹叶更为其增添了一抹清香，很好清去了舌尖上残留的黑醋风味，温暖肠胃的同时诱惑着食客期待起下一道佳肴。"
    "スープに浮かぶパセリの葉が清涼な香りを添え、舌に残っていたバルサミコ酢の余韻をきれいに洗い流す。同時に胃を温め、次の一皿への期待を自然と誘い出していた。"

# game/script/daily_feed.rpy:593
translate japanese food_h3_614b2de9:

    # "在汤碗见底后，L短暂地将空碗放到了囚室的地上，随后伸手端起了第三层的两个圆盖，连着餐盘一同送到了月的面前。"
    "スープカップが空になった後、Lは一時的に空のカップを牢獄の床に置いた。その後、手を伸ばして三段目の二つのドームを持ち上げ、トレイごと月の前に運んだ。"

# game/script/daily_feed.rpy:604
translate japanese food_h3_28cd782c:

    # "L面朝着月揭开了了第一个圆盖，底下雕金的瓷盘里整齐地码放着四块被酥皮包裹着的牛肉，"
    "Lは月に向き直って最初のドームを開けた。下には金の彫刻が施された陶器の皿に、パイ皮で包まれた牛肉が四切れ整然と並べられていた。"

# game/script/daily_feed.rpy:604
translate japanese food_h3_8d930258:

    # "牛肉的火候掌握得正好、内里还呈现出浅嫩的粉色，用刀叉切开还会随着动作流淌出丰盈的肉汁。"
    "牛肉の火加減は完璧で、中身はまだ淡いピンク色をしており、ナイフとフォークで切ると動作に合わせて豊潤な肉汁が流れ出た。"

# game/script/daily_feed.rpy:604
translate japanese food_h3_24223202:

    # "酥皮与牛肉间细细填充着半块油润的鹅肝和黑松露与口蘑炒制而成的蘑菇泥，用刀叉切开酥皮后又能窥见夹层间的火腿，"
    "パイ生地と牛肉の間には半切れの豊潤なフォアグラと、黒トリュフとマッシュルームを炒めて作ったキノコペーストが詰められている。パイ皮をナイフで切るとさらに層の間にハムが挟まれているのが覗えた。"

# game/script/daily_feed.rpy:604
translate japanese food_h3_125e2d6c:

    # "棕色的造型酱汁上佐以翠绿色的芦笋，几乎可以说是堪称满分的惠灵顿牛排出品。"
    "ブラウンソースの上には鮮やかな翠のアスパラが添えられ、間違いなく完璧なウェリントンステーキの出来栄えと言えた。"

# game/script/daily_feed.rpy:615
translate japanese food_h3_c52be788:

    # "L先将沙拉和刚才的空碗换位、拿到第一层摆到了月的面前，专用的沙拉叉被一并码在餐盘旁边。"
    "Lはまずサラダと先ほどの空のカップを入れ替え、トレイの一段目から取り出して月の前に置いた。専用のサラダフォークも一緒にトレイの傍らに並べられた。"

# game/script/daily_feed.rpy:615
translate japanese food_h3_4e4ff323:

    # "月观察着沙拉，在L将碗盘挪近后他看清了更多细节："
    "月はサラダを観察し、Lがカップと皿を近くに移動させた後、より多くの細部を見て取った："

# game/script/daily_feed.rpy:615
translate japanese food_h3_54ff9012:

    # "除去鲜果外，这份沙拉还混入了圣女果干和磨碎的起司，沙拉表面细细淋了些意大利黑醋。"
    "フレッシュフルーツに加えて、ドライトマトと削ったチーズが和えられ、仕上げに表面へバルサミコ酢が細く垂らされていた。"

# game/script/daily_feed.rpy:615
translate japanese food_h3_d192d9d9:

    # "月用叉子插入沙拉底部翻拌，橄榄油便和黑醋混合在一块，上下包裹起每一片蔬菜。"
    "月がフォークをサラダの底に差し入れてかき混ぜると、オリーブオイルがバルサミコ酢と混ざり合い、上下から野菜一枚一枚を包み込んだ。"

# game/script/daily_feed.rpy:615
translate japanese food_h3_f5a88d98:

    # "在刚才黄油浓厚的味道对味蕾造成冲击后，酸甜的蔬果沙拉很好起到了清口的作用，月一口接一口叉起沙拉送入口中，很快将碗内的食物一扫而空。"
    "先ほどの濃厚なバターの風味で舌が重くなったあと、酸味と甘みの効いたフルーツ入りのサラダは絶好のリフレッシュとなった。月は次々とフォークを動かし、あっという間に器の中を空にしてしまった。"

# game/script/daily_feed.rpy:627
translate japanese food_h3_8659711b:

    # "摆在右手边汤碗里的是法餐中对技巧要求相当严苛的清汤，月只在母亲幸子收藏的法国菜谱中见过做法———"
    "右手側のスープカップには、フレンチでも高度な技術を要するコンソメスープが入っていた。月は母である幸子が収集していたフランス料理のレシピ集で、その作り方を見たことがあるだけだった ——"

# game/script/daily_feed.rpy:627
translate japanese food_h3_dd2f50bc:

    # "将蔬菜细细切碎后和蛋清搅打均匀、再加入碎牛肉猪肉混合制成肉糜，倒入鸡高汤和肉糜一同熬煮几个小时，"
    "野菜を細かく刻んで卵白と混ぜ合わせ、さらに牛肉と豚肉の挽き肉を加えて肉餡を作り、それを鶏のブイヨンに入れて数時間煮込む。"

# game/script/daily_feed.rpy:627
translate japanese food_h3_cb145704:

    # "依靠蛋白质吸附杂质，最终得到一碗看似白水、味道却极度鲜美的高汤。"
    "タンパク質が不純物を吸着することで、最終的に水のように見えるが、味は非常に美味しいスープが完成する。"

# game/script/daily_feed.rpy:627
translate japanese food_h3_294250e1:

    # "月握住汤勺的匙柄，舀起一勺清汤送入口中，蔬菜的甜美和肉类蛋白的复杂风味完全被锁在汤品中，使得咽下去后仍然回味生香，"
    "月はスプーンを取り、澄んだスープをひと口すくって口に含んだ。野菜の甘みと肉の旨みがぎゅっと閉じ込められ、飲み込んだ後も芳醇な余韻が口いっぱいに広がっていた。"

# game/script/daily_feed.rpy:627
translate japanese food_h3_90d19b38_1:

    # "碗中盛放的欧芹叶更为其增添了一抹清香，很好清去了舌尖上残留的黑醋风味，温暖肠胃的同时诱惑着食客期待起下一道佳肴。"
    "スープに浮かぶパセリの葉が清涼な香りを添え、舌に残っていたバルサミコ酢の余韻をきれいに洗い流す。同時に胃を温め、次の一皿への期待を自然と誘い出していた。"

# game/script/daily_feed.rpy:627
translate japanese food_h3_b7dba1af:

    # "L在月进食完后收起了碗碟，他短暂地将空碗放到了囚室的地上，随后伸手端起了第三层的两个圆盖，连着餐盘一同送到了月的面前。"
    "L は月が食べ終わった後、カップとお皿を片付け、一時的に空のカップを独房の床に置いた。その後、手を伸ばして三段目の二つのドームを持ち上げ、トレイごと月の前に運んだ。"

# game/script/daily_feed.rpy:641
translate japanese food_h3_0ae52ee1:

    # "L揭开了第一个圆盖，底下雕金的瓷盘里整齐地码放着四块被酥皮包裹着的牛肉，"
    "Lが最初の丸い蓋を開けると、金で装飾された磁器の皿の上に、パイ生地に包まれた四切れの牛肉がきちんと並べられていた。"

# game/script/daily_feed.rpy:641
translate japanese food_h3_8d930258_1:

    # "牛肉的火候掌握得正好、内里还呈现出浅嫩的粉色，用刀叉切开还会随着动作流淌出丰盈的肉汁。"
    "牛肉の火加減はちょうど良く、中身はまだ柔らかいピンク色をしており、ナイフとフォークで切ると、動きに合わせて豊かな肉汁が流れ出した。"

# game/script/daily_feed.rpy:641
translate japanese food_h3_24223202_1:

    # "酥皮与牛肉间细细填充着半块油润的鹅肝和黑松露与口蘑炒制而成的蘑菇泥，用刀叉切开酥皮后又能窥见夹层间的火腿，"
    "パイ生地と牛肉の間には半切れの豊潤なフォアグラと、黒トリュフとマッシュルームを炒めて作ったキノコペーストが詰められている。パイ皮をナイフで切るとさらに層の間にハムが挟まれているのが覗えた。"

# game/script/daily_feed.rpy:641
translate japanese food_h3_125e2d6c_1:

    # "棕色的造型酱汁上佐以翠绿色的芦笋，几乎可以说是堪称满分的惠灵顿牛排出品。"
    "ブラウンソースの上には鮮やかな翠のアスパラが添えられ、間違いなく完璧なウェリントンステーキの出来栄えと言えた。"

# game/script/daily_feed.rpy:653
translate japanese food_h3_b121c80f:

    # L smile3 "月君知道这道餐品的正式名称是Beef Willington吗？"
    L smile3 "夜神くん、この料理の正式名称がビーフウェリントンだと知っていますか？"

# game/script/daily_feed.rpy:654
translate japanese food_h3_6890bdf6:

    # L "相传这道菜品是因为第一位惠灵顿公爵在滑铁卢战役中击败了拿破仑而得名的，"
    L "この料理は、初代ウェリントン公爵がワーテルローの戦いでナポレオンを打ち破ったことから名付けられたと伝えられています。"

# game/script/daily_feed.rpy:654
translate japanese food_h3_7bd16248:

    # L "首次亮相便是那场战役的庆功宴，所以使用的食材多是当时贵族御用的材料，算得上极尽奢华。"
    L "初めて披露されたのはその戦いの祝勝宴で使用された食材は当時の貴族御用達のものばかりでした。まさに極めて豪華といえるでしょう。"

# game/script/daily_feed.rpy:658
translate japanese food_h3_0f42292e:

    # "月方才还有些期待这道卖相上佳的菜品，他在三十秒前也确实感谢过L的菜品介绍，额外的知识在解闷的同时的确也为菜品增色不少———"
    "月はさっきまでこの見た目の良い料理に期待を寄せていたし、三十秒前にも L の料理の説明に感謝したばかりだった。ちょっとした知識は退屈を和らげ、料理の味わいに彩りを添えてくれるものだった――"

# game/script/daily_feed.rpy:658
translate japanese food_h3_67f14ef6:

    # "但现在他只想把这道寓意讨厌的菜砸到L那张讨厌的脸上，然后叫L远远地滚出去。"
    "だが今は、この縁起の悪い料理をLの忌々しい顔に投げつけ、そしてLに遠くへ出て行けと叫びたいだけだった。"

# game/script/daily_feed.rpy:662
translate japanese food_h3_c12a4ae8:

    # Y angry "你这是什么意思？费尽心思请人做了一顿大餐来羞辱我？"
    Y angry "どういう意味だ？わざわざ豪華な食事を準備して僕を侮辱したいのか？"

# game/script/daily_feed.rpy:663
translate japanese food_h3_d1fdda8d:

    # Y "还真是相当有闲空啊，伟大的L在获胜之后没有别的事情可以干了，居然以侮辱阶下囚为乐。"
    Y "「本当にずいぶん暇なんだな。偉大なるLは勝利した後、他にやることがなくて、囚人を侮辱して遊ぶのが趣味になったのか？"

# game/script/daily_feed.rpy:664
translate japanese food_h3_8bee5c70:

    # L confused "夜神君误会了，我没有那个意思。"
    L confused "夜神くん、誤解です。そんな意図はありません。"

# game/script/daily_feed.rpy:665
translate japanese food_h3_a039f4b4:

    # Y "那你倒是解释一下呢？龙崎？"
    Y "じゃあ、どういう意味か説明してみろよ？　竜崎？"

# game/script/daily_feed.rpy:666
translate japanese food_h3_525e120b:

    # L pt "这道菜是法餐的经典菜品……夜神君知道六本木的王道法餐OOO吗？"
    L pt "この料理はフレンチの定番料理です…… 夜神くんは、六本木の有名フレンチを知っていますか？"

# game/script/daily_feed.rpy:666
translate japanese food_h3_83982154:

    # L pt "我只是订购了他们家的主推套餐，当然，餐品的介绍也是原样照搬了宣传册上的语句。"
    L pt "私はただ、あの店のおすすめコースを注文しただけです。料理の説明もパンフレットの内容をそのまま引用したものです。"

# game/script/daily_feed.rpy:669
translate japanese food_h3_2d928ef3:

    # L unhappy "……抱歉，如果让夜神君不愉快的话，请当作我什么都没说过吧。"
    L unhappy "…… 申し訳ありません。夜神くんを不快にさせたのであれば、私の言ったことは忘れてください。"

# game/script/daily_feed.rpy:671
translate japanese food_h3_4d6588d5:

    # "月没有接过L的话头，他相当厌恶地闭上了眼睛，以此来表示今天和L言尽于此，他不会再多说一个字。"
    "月はLの言葉を受け取らず、強い嫌悪の表情で目を閉じた。それは今日の会話はここまでだという意思表示であり、これ以上一言も話すつもりはなかった。"

# game/script/daily_feed.rpy:671
translate japanese food_h3_527bc2fe:

    # "不论L再怎么尝试和月对话，也没有得到任何除了沉默以外的回复。"
    "L がどんなに月と話そうとしても、沈黙以外の返答は得られなかった。"

# game/script/daily_feed.rpy:671
translate japanese food_h3_09649bc3:

    # "L只能放弃了接下来的喂食行动，推着餐车离开了囚室。"
    "L は仕方なく後の給仕を断念し、カートを押して牢獄を離れた。"

# game/script/daily_feed.rpy:683
translate japanese food_h3_a8d877f4:

    # "L相当贴心地为月摆上了更换用的餐具，餐叉、锯齿状的餐刀，和一柄木质把手的甜品餐叉。"
    "L は細やかに月のために取り替え用の食器を並べた —— フォーク、鋸歯状のディナーナイフ、それに木製の持ち手がついたデザートフォークだ。"

# game/script/daily_feed.rpy:683
translate japanese food_h3_bfb9e749:

    # "月捏住餐刀的匙柄，从中间切开惠灵顿牛排，随后将牛肉连着酥皮一同翻面，叉起一块送入嘴中。"
    "月はディナーナイフの持ち手を握り、真ん中からビーフウェリントンを切り分け、続いて牛肉を酥皮ごと反転させて、一かけらフォークで刺して口に運んだ。"

# game/script/daily_feed.rpy:683
translate japanese food_h3_25297bc2:

    # "黑松露独有的菌菇香气很快席卷了口腔，浓醇的鹅肝入口即化、配上微咸的火腿进一步迸发出鲜味，柔软的牛里脊肉汁饱满，在咀嚼间渐渐和其他食材融为一体。"
    "黒トリュフ特有のキノコの香りがすぐに口腔に広がり、濃厚なフォアグラは口の中でとろけ、薄塩のハムと合わさってさらに旨味が引き立ち、柔らかい牛ロース肉は肉汁たっぷりで、噛むたびに他の食材と自然に溶け合っていった。"

# game/script/daily_feed.rpy:683
translate japanese food_h3_892adc69:

    # "月不时切开芦笋、沾满酱汁后一道送入口中，蔬菜甘美的甜味缓解了牛排的油腻，总让人忍不住舀起第二口美味的菜肴。"
    "月は時折アスパラを切り分け、ソースをたっぷりつけて一緒に口に運ぶ。野菜の甘い味がステーキの脂っこさを和らげてくれて、思わず次の一口を挟みたくなる美味さだった。"

# game/script/daily_feed.rpy:683
translate japanese food_h3_a87789d1:

    # "惠灵顿牛排很快就在月的攻势下被一扫而光。月拿起餐巾擦了擦嘴，在等待L撤掉盘子的功夫观察起最后一道收尾的甜品。"
    "ビーフウェリントンはすぐに月の手によって食べ尽くされた。月はナプキンで口を拭き、L がお皿を取り除くのを待つ間に、最後のデザートを観察し始めた。"

# game/script/daily_feed.rpy:694
translate japanese food_h3_6d45d923:

    # "L端上来的第二个圆盘里装着压轴的树莓蛋糕，"
    "Lが差し出した二つ目の丸皿には、最後を飾るラズベリーケーキが載っていた。"

# game/script/daily_feed.rpy:694
translate japanese food_h3_6dfbca65:

    # "切成长方形的蛋糕有着漂亮的横截面，奶油和果酱层层交叠着，最上层封上了厚厚的奶酪，顶端则点缀着一颗颗淋着糖浆的树莓。"
    "長方形に切り分けられたケーキは、クリームとジャムが幾層にも重なる美しい断面を見せている。仕上げに濃厚なチーズが厚く塗られ、頂にはシロップをまとったラズベリーが宝石のようにあしらわれていた。"

# game/script/daily_feed.rpy:694
translate japanese food_h3_efd6dfc4:

    # "月用餐叉切开蛋糕的一角，白色的奶酪经过调味在入口时不显厚重，果酱夹层恰到好处提供了水果丰盈的气味，"
    "月はデザートフォークでケーキの一角を切り分けた。白いチーズは味付けが工夫されていて口に入れても重たく感じられず、ジャムの層がちょうどよく果実の豊かな香りを添えていた。"

# game/script/daily_feed.rpy:694
translate japanese food_h3_6ed48da6:

    # "顶端的覆盆子在咀嚼时爆开、流露出内里酸甜的果汁。"
    "頂にのったラズベリーは噛むと弾け、中から甘酸っぱい果汁があふれ出た。"

# game/script/daily_feed.rpy:694
translate japanese food_h3_067591f3:

    # "最后的甜品对月来说略显甜腻，即使他再努力也依旧剩下半块蛋糕留在碟子中央。"
    "しかし、締めのデザートは月には少し甘すぎて、結局半分のケーキが皿の真ん中に残ってしまった。"

# game/script/daily_feed.rpy:704
translate japanese food_h3_a5665216:

    # L surprise "怎么了夜神君？蛋糕还没有吃完哦。"
    L surprise "どうしたんですか夜神くん？　ケーキは食べ終わっていませんが"

# game/script/daily_feed.rpy:705
translate japanese food_h3_acb0fcfe:

    # Y pt "……我已经吃饱了。"
    Y pt "…… 悪いけどもう満腹だ。"

# game/script/daily_feed.rpy:706
translate japanese food_h3_526ffdd5:

    # L order2 "是这样吗？这家甜品的调味做得很棒，也是我个人排行榜的Top.10呢。如果夜神君不吃的话，剩下的可以让给我吗？"
    L order2 "そうですか？ここのデザートは本当に出来が良くて、私の個人的なトップ10に入っています。夜神くんが食べないなら、残りは私がいただいてもいいですか？"

# game/script/daily_feed.rpy:707
translate japanese food_h3_5fbbc878:

    # Y "可以是可以，但是龙崎在来之前应该已经吃过饭了吧？"
    Y "別にいいけど、お前はもう来る前に食べたんじゃないのか？"

# game/script/daily_feed.rpy:708
translate japanese food_h3_a502e58e:

    # L smile1 "是啊，不过看见月君吃得那么美味的样子，总感觉肚子又饿了呢。"
    L smile1 "そうです。ですが、夜神くんが美味しそうに食べているのを見ると、またお腹が空いてきたような気がします。"

# game/script/daily_feed.rpy:709
translate japanese food_h3_26a19113:

    # Y han "（……完全搞不懂龙崎在想什么）"
    Y han "（…… まったく竜崎の考えが理解できない）"

# game/script/daily_feed.rpy:711
translate japanese food_h3_06f52d42:

    # "月纠结了一会，还是伸手将剩下的半块蛋糕推到了L那边，黑发男人相当灵巧地跨过月坐上囚室的床铺，接过月递来的餐刀开始消灭起蛋糕。"
    "月はしばらく迷った後、手を伸ばして残り半分のケーキを L の方へ押した。Lは器用に月のそばを越えて牢獄のベッドに座り、月が渡したナイフを受け取ってケーキを食べ始めた。"

# game/script/daily_feed.rpy:713
translate japanese food_h3_3fa32c87:

    # Y jiaoji3 "（等下，这把叉子好像就是自己刚才用的那把吧？！）"
    Y jiaoji3 "（いや待て、このフォーク、さっき僕が使ってたやつじゃないか？！）"

# game/script/daily_feed.rpy:715
translate japanese food_h3_9786d6b3:

    # "意识到了什么不对的月耳根迅速红了起来，想阻止L吞咽的动作又晚上一步，只能眼睁睁地看着甜品被L吞吃入腹。"
    "なんだか気まずさを覚えた月は耳が急に赤くなり、L が飲み込む動きを止めようとしたが遅かった。ただ無力にデザートが L に食べられるのを見つめていた。"

# game/script/daily_feed.rpy:715
translate japanese food_h3_73c14ffc:

    # "侦探甚至细细舔去了餐叉上的奶油，直到再也尝不出甜味后才依依不舍地放下叉子收拾起餐具。"
    "探偵はフォークに残ったクリームさえも丁寧に舐め取り、甘さを感じなくなるまで味わい尽くした。そしてようやく名残惜しげにフォークを置き、食器を片付けに取りかかる。"

# game/script/daily_feed.rpy:719
translate japanese food_h3_6d782e11:

    # L smile3 "一如既往的美味，感谢月君的招待。"
    L smile3 "いつも通り美味しかったですね。夜神くん、ご馳走様でした。"

# game/script/daily_feed.rpy:720
translate japanese food_h3_05671f09:

    # "月有些不自在地看着那把甜品餐叉，吞吞吐吐地跟着L一起说出结语。"
    "月は落ち着かない様子でデザートフォークに視線を向け、言い淀みながらもLに合わせて結びの言葉を口にした。"

# game/script/daily_feed.rpy:721
translate japanese food_h3_3d642a25:

    # Y pt "……我吃饱了，感谢招待。"
    Y pt "…… ご馳走様。"

# game/script/daily_feed.rpy:723
translate japanese food_h3_39fe6a26:

    # "在短暂的插曲过后，L重新为月戴上手铐和脚镣，推着餐车离开了囚室。"
    "短いひとときの余興が終わると、Lは再び月に手錠と足かせをつけ、ワゴンを押して牢獄を後にした。"

# game/script/daily_feed.rpy:723
translate japanese food_h3_1a7cf6d5:

    # "只是这一次，月盯着L离去的背影，一点点陷入了沉思。"
    "ただ今回だけは、月は L の去り行く背中を見つめながら、ゆっくりと思考に浸ることになった。"

# game/script/daily_feed.rpy:729
translate japanese food_h4_2a01c200:

    # "今天L推着餐车来到囚室时月正在床上闭眼小憩，长时间的囚禁生活似乎十分消耗青年的精力，他的体重比进入囚室时要轻上许多，"
    "今日、Lがワゴンを押して牢獄にやって来たとき、月はベッドで目を閉じて仮眠を取っていた。長期間の監禁生活は青年の精力を大いに消耗させたようで、彼の体重は牢獄に入った当初よりもかなり減っていた。"

# game/script/daily_feed.rpy:729
translate japanese food_h4_73538e69:

    # "这使得L不得不大幅提升日常饮食的质量，让月从三餐中获取足够的营养。"
    "そのためLは、月が三度の食事できちんと栄養を取れるよう、日々の食事内容を大きく引き上げざるを得なかった。"

# game/script/daily_feed.rpy:733
translate japanese food_h4_812e9220:

    # L "夜神君，已经到吃饭的时间了。"
    L "夜神くん、食事の時間です。"

# game/script/daily_feed.rpy:734
translate japanese food_h4_8797a62e:

    # "L拍了拍躺在床上的青年，尝试把仍在睡梦中的月扶起来吃饭。月对突入其来的触碰表现出了不满，闷哼着就想挣脱开继续躺回床铺。"
    "Lはベッドに眠る月の体を軽く叩き、食事のために起こそうとした。だが月は突然の接触に不快そうな唸り声をあげ、振りほどいて再びベッドに身を沈めようとした。"

# game/script/daily_feed.rpy:735
translate japanese food_h4_454d3465:

    # Y ditou "唔……龙崎……"
    Y ditou "うん…… 竜崎……"

# game/script/daily_feed.rpy:736
translate japanese food_h4_ecc9b9a8:

    # Y "让我再睡一会……"
    Y "もう少し眠らせて……"

# game/script/daily_feed.rpy:737
translate japanese food_h4_e754bfa4:

    # L surprise "（夜神这是睡迷糊了吗，为什么语气听起来有点像在撒娇？）"
    L surprise "（夜神くんは眠りが浅いようだ……しかし、なぜこんな甘えるような口調に聞こえるのか）"

# game/script/daily_feed.rpy:738
translate japanese food_h4_386086b3:

    # "在L坚持不懈的努力下月终于开始有了苏醒的迹象，他直起身子坐到了床边，顶着一头乱蓬蓬的头发，睡眼惺忪地打着哈欠。"
    "L が諦めずに努力した結果、月はやっと起き始める兆しを見せた。体を起こしてベッドの端に座り、髪を乱したまま、眠そうな目であくびをした。"

# game/script/daily_feed.rpy:738
translate japanese food_h4_e9511682:

    # "兴许是青年迷糊的样子削弱了平日里两人剑拔弩张的气氛，L鬼使神差地伸出手，摸了摸月的脑袋，从前往后捋顺了月有些杂乱的发丝。"
    "青年の眠そうな姿が、普段の一触即発の空気を和らげたのかもしれない。L は思わず手を伸ばして月の頭を撫で、前から後ろへと乱れた髪をなで直した。"

# game/script/daily_feed.rpy:741
translate japanese food_h4_66d00e1d:

    # L thinking "（原来夜神的头发是这种触感的）"
    L thinking "（夜神くんの髪の毛はこんな触感だったのか）"

# game/script/daily_feed.rpy:747
translate japanese food_h4_ba27f41d:

    # "L没有解开月手铐的意思，只是从餐盘上拿起塑封好的热毛巾帮月简单擦拭了一下面部，"
    "L は月の手錠を外す意図はなく、トレイから密封された温かいタオルを取り、月の顔を簡単に拭いた。"

# game/script/daily_feed.rpy:747
translate japanese food_h4_23b9e3d1:

    # "月这会完全醒了过来，意识到刚刚L抚摸自己脑袋的举动后有些不自在地和躲开L擦拭的动作，扭动着向后和L拉开了一点距离。"
    "月はその瞬間にはっきり目を覚まし、先ほどLに頭を撫でられたことを思い出して居心地悪そうに身を引いた。Lが拭こうとする手を避けるように体をよじり距離を取った。"

# game/script/daily_feed.rpy:751
translate japanese food_h4_818d5850:

    # Y pt "龙崎不是来送饭的吗？那就不要做多余的动作了，我们没有那么亲昵吧。"
    Y pt "竜崎、おまえは食事を届けに来たんだろ？　なら余計なことをするな。僕らはそんなに親しくないだろ。"

# game/script/daily_feed.rpy:752
translate japanese food_h4_86aebce2:

    # L pt "啊，只是确保清洁的擦拭而已，夜神君不用在意。"
    L pt "あ、清潔を保つためです。夜神くんは気にしなくても構いません。"

# game/script/daily_feed.rpy:753
translate japanese food_h4_375c3d2c:

    # Y renzhen "我说的明明是你不经同意就摸我头发的行为。"
    Y renzhen "僕が言ったのは、許可を取らずに僕の髪を触ったことだ。"

# game/script/daily_feed.rpy:754
translate japanese food_h4_7c4170dc:

    # L surprise "……那是因为夜神君看上去很好摸…？"
    L surprise "……それは、夜神くんがとても撫で心地よさそうに見えたから……？"

# game/script/daily_feed.rpy:755
translate japanese food_h4_08e42a16:

    # Y surprise "为什么是疑问句？？"
    Y surprise "なんで疑問文なんだ？？"

# game/script/daily_feed.rpy:759
translate japanese food_h4_f984c66e:

    # "L没有继续回应月的问题，他揭开了餐车上的保温罩，下方中规中矩地摆放着一只白色的瓷盘，"
    "Lは月の問いにそれ以上答えず、ワゴンの保温カバーを外した。その下には、きちんと整えられた白い磁器の皿が置かれていた。"

# game/script/daily_feed.rpy:759
translate japanese food_h4_d57c4123:

    # "一块炖到酥烂的牛肉上点缀着零散的罗勒香叶，周边依次散落着成块的胡萝卜和圆球形的小颗洋葱，散发着浓郁红酒与酱油香气的酱汁满满盛在盘中。"
    "柔らかく煮崩れるほど煮込まれた牛肉の上に、バジルの葉がさりげなく飾られている。周りにはゴロリとしたニンジンや小ぶりの丸玉ねぎが添えられ、赤ワインと醤油の香りを濃厚にまとったソースが皿いっぱいに満ちていた。"

# game/script/daily_feed.rpy:759
translate japanese food_h4_5ad5d8b1:

    # "L用刀叉仔细地切下一块牛肉浸上酱汁，又舀起一点土豆泥放到餐勺上，最后将牛肉和小块的蔬菜移到土豆泥上方，组合成小份的红酒炖牛肉喂到月的嘴边。"
    "Lはフォークとフォークで牛肉を丁寧に切り分け、ソースを絡める。さらにスプーンにマッシュポテトをすくい、その上へ牛肉と小さな野菜を載せて、一口サイズの赤ワイン煮を仕立てると、そのまま月の口元へ差し出した。"

# game/script/daily_feed.rpy:759
translate japanese food_h4_e07a5c7b:

    # "炖肉选用了上好的牛肋条，肉类在高温下完美的美拉德反应带来了焦香浓郁的味道，"
    "煮込みには極上の牛バラ肉が選ばれ、高温での見事なメイラード反応によって、香ばしく深みのある味わいが引き出されていた。"

# game/script/daily_feed.rpy:759
translate japanese food_h4_15c86199:

    # "胡萝卜和洋葱在炖煮后仍然保留了蔬菜的香甜，和着微酸的红酒酱汁十分解腻。"
    "ニンジンとタマネギは煮込んでも野菜の甘みを保っており、微酸っぱい赤ワインソースと合わせて脂っこさをよく取り除いてくれた。"

# game/script/daily_feed.rpy:759
translate japanese food_h4_8fe7cdc0:

    # "打底的土豆泥也细细拌入了黄油，甚至还保留了些许小块土豆以增添咀嚼时的口感。"
    "ベースのポテトピューレにもバターが細かく混ぜられており、さらに少しの大きめのポテトの塊も残されて、噛む時の食感を添えている。"

# game/script/daily_feed.rpy:773
translate japanese food_h4_f9703533:

    # "月相当满意地品味着这道炖菜料理，在完食后仍意犹未尽地盯着L收拾餐具的举动，他又想起L刚进入囚室时抚摸自己头部的奇怪动作。"
    "月はこの煮込み料理に大いに満足し、食べ終えたあともどこか名残惜しげにLが食器を片付ける姿を見ていた。その時ふと、Lが囚室に入ってきたとき、自分の頭を撫でたあの奇妙な仕草を思い出した。"

# game/script/daily_feed.rpy:773
translate japanese food_h4_3f956aba:

    # "如果L对自己有那方面想法的话……或许和L建立比较良好的关系也不错？"
    "もし L が自分にそういった思いがあるのだとしたら… もしかしたら L と良好な関係を築いた方が良いのだろうか？"

# game/script/daily_feed.rpy:779
translate japanese food_h4_463d6d4e:

    # "在正式进食前L替月解开了手铐和脚镣，刚起床的青年还带着困意，磨磨蹭蹭地走到洗手池旁拧开水龙头，简单捧起水清理了一下面部刷了个牙。"
    "正式に食事を始める前に、L は月の手錠と足かせを外した。起きたばかりの青年はまだ眠気が残っており、ぐずぐずと手洗い場まで行って水道を開き、簡単に水を汲んで顔を拭き、歯を磨いた。"

# game/script/daily_feed.rpy:779
translate japanese food_h4_20610f05:

    # "L跟在一旁，在恰到好处的时机把毛巾递给月。"
    "L はそばについていき、ちょうど良いタイミングでタオルを月に渡した。"

# game/script/daily_feed.rpy:782
translate japanese food_h4_5ea7636e:

    # L pt "请用。"
    L pt "どうぞ。"

# game/script/daily_feed.rpy:783
translate japanese food_h4_829b99c4:

    # Y pt "……谢谢。"
    Y pt "…… ありがとう。"

# game/script/daily_feed.rpy:785
translate japanese food_h4_0180ae39:

    # "L看着月坐回床上，像只睡到餍足的猫似地伸起懒腰。"
    "Lはベッドに戻り腰を下ろした月が、満腹で眠る猫のように伸びをするのを見つめていた。"

# game/script/daily_feed.rpy:785
translate japanese food_h4_0b4e9969:

    # "L将餐车推到月的面前，他揭开了餐车上的保温罩，并将用餐巾包好的餐具递给月。"
    "L はカートを月の面前に押し寄せ、保温カバーを開けた後、ナプキンで包まれた食器を月に渡した。"

# game/script/daily_feed.rpy:792
translate japanese food_h4_4f62f386:

    # "月看见保温罩的下方中规中矩地摆放着一只白色的瓷盘，一块炖到酥烂的牛肉上点缀着零散的罗勒香叶，"
    "月は、保温カバーの下にきちんと並べられた白い磁器の皿を目にした。そこには、ほろほろに煮込まれた牛肉が盛られ、その上にバジルの葉が散りばめられていた。"

# game/script/daily_feed.rpy:792
translate japanese food_h4_0e366213:

    # "周边依次散落着成块的胡萝卜和圆球形的小颗洋葱，散发着浓郁红酒与酱油香气的酱汁满满盛在盘中。"
    "周りには角切りのニンジンと丸い小さなタマネギが散らばっており、濃厚な赤ワインと醤油の香りのするソースがお皿にたっぷり盛られていた。"

# game/script/daily_feed.rpy:796
translate japanese food_h4_8faa44d2:

    # Y smile1 "我开动了。"
    Y smile1 "いただきます。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_bbda7705:

    # "在简短的饭前例行公事后，浓郁的香气很快促使着月用刀叉仔细地切下一块牛肉浸上酱汁，"
    "簡単な食前の礼の後、濃厚な香りに促されて、月はナイフとフォークで丁寧に牛肉を切り取りソースに浸した。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_ab709893:

    # "他又舀起一点土豆泥放到餐勺上，最后将牛肉和小块的蔬菜移到土豆泥上方，组合成小份的红酒炖牛肉送入嘴中。"
    "さらにポテトピューレをスプーンで少しすくい取り、牛肉と小さな野菜をポテトピューレの上に移して、小分けの赤ワイン煮牛肉にして口に運んだ。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_d5b6c803:

    # "月能品尝出炖肉选用了上好的牛肋条，肉类在高温下完美的美拉德反应带来了焦香浓郁的味道，"
    "月は口に含んだ瞬間、煮込みに極上の牛バラ肉が使われていると分かった。高温での完璧なメイラード反応が、香ばしく濃厚な風味をもたらしていた。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_15c86199_1:

    # "胡萝卜和洋葱在炖煮后仍然保留了蔬菜的香甜，和着微酸的红酒酱汁十分解腻。"
    "ニンジンとタマネギは煮込んでも野菜の甘みを保っており、微酸っぱい赤ワインソースと合わせて脂っこさをよく取り除いてくれた。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_8fe7cdc0_1:

    # "打底的土豆泥也细细拌入了黄油，甚至还保留了些许小块土豆以增添咀嚼时的口感。"
    "ベースのポテトピューレにもバターが細かく混ぜられており、さらに少しのポテトの塊も残されて、噛む時の食感を添えている。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_ef7fbd38:

    # "月相当满意地品味着这道炖菜料理，"
    "月はこの煮込み料理をかなり満足そうに味わった。"

# game/script/daily_feed.rpy:798
translate japanese food_h4_9d3a216b:

    # "虽然是没吃过的食谱，不过近日来逐渐丰富起来的菜式的确很好缓解了他的精神压力，让月不自觉地期待起下一餐L会带来什么。"
    "食べたことのない料理ではあったが、ここ最近少しずつ豊かになってきた献立は、確かに彼の精神的な負担を和らげてくれた。そのため、月は思わず次の食事にLが何を持ってくるのかを期待してしまった。"

# game/script/daily_feed.rpy:812
translate japanese food_h4_bdd74bec:

    # "月很快用牛肉配着土豆泥将整碟菜肴吃了个精光，他盯着L收拾餐具时的背影，没来由地在脑海中冒出一句话。"
    "月は牛肉とポテトピューレをあっという間に平らげる。片づけに向かうLの背中を眺めながら、なぜか心の中にひとつの言葉がふと浮かび上がった。"

# game/script/daily_feed.rpy:812
translate japanese food_h4_a157b9a1:

    # "如果可以利用L的好感来改善生活条件的话……也许是时候选择缓和两人的关系了。"
    "もし L の好意を利用して生活環境を改善できるのだとしたら… そう考えると、今こそ彼との関係を歩み寄る時なのかもしれない。"

# game/script/daily_feed.rpy:818
translate japanese food_h5_74e3bb79:

    # "L推着金属制的银色餐车进入了囚室，今天推车上多了一台便携式卡式炉，炉灶上放着一只砂锅，锅盖上的气孔随着炖煮一股股向外喷着热气。"
    "L は金属製の銀色のワゴンを押して牢獄に入ってきた。今日のワゴンにはカセットコンロが追加されており、そのコンロの上には土鍋が置かれていた。鍋の蓋にある蒸気孔からは、煮込みに合わせて絶え間なく湯気が吹き出している。"

# game/script/daily_feed.rpy:818
translate japanese food_h5_3bbddf9c:

    # "月能从空气的流动中闻到很美妙的味道，一丝丝海产品的鲜香不断顺着呼吸钻入他的鼻腔。"
    "ふわりと流れる空気に混じって、月の鼻先を心地よい香りがくすぐった。海の幸ならではの旨みが、呼吸のたびに細やかに鼻腔へと染み込んでいった。"

# game/script/daily_feed.rpy:818
translate japanese food_h5_fb46ffc0:

    # "L很快将推车送到了月的面前，除去冒出香味的砂锅外，餐车最上层摆着一碟瓷盘，里头孤零零地盛着一颗西兰花。"
    "Lはすぐにワゴンを月の前へと運んできた。香りを立ちのぼらせている土鍋のほかに、ワゴンの最上段には一枚の磁器の皿が置かれており、その中にはぽつんとブロッコリーが一つだけ盛られていた。"

# game/script/daily_feed.rpy:818
translate japanese food_h5_a96eb0cc:

    # "瓷盘旁则有一只装满米饭的小碗，最上面随意地撒了些黑芝麻作为点缀。"
    "皿の隣にはご飯をよそった小さな茶碗があり、表面には黒ゴマが無造作に散らされて彩りを添えていた。"

# game/script/daily_feed.rpy:818
translate japanese food_h5_4c7fa251:

    # "L当着月的面揭开了砂锅，锅内咕嘟咕嘟地煮着圆形的花菇和足有成年人手掌大小的干鲍，褐色的汤汁均匀地裹在食材上，"
    "L は月の前で土鍋の蓋を開ける。鍋の中では丸い花椎茸と、大人の手のひらほどもある大きさの干しアワビがぐつぐつと煮えており、褐色のスープが食材にまんべんなく絡みついていた。"

# game/script/daily_feed.rpy:828
translate japanese food_h5_934ba7b4:

    # "L用餐叉将鲍鱼与花菇捞起，小心翼翼地放到瓷盘上，随后提起勺子为餐盘内的食物淋上熬煮后香气四溢的浓稠汤汁，在稍加调整后将整盘餐食送到了月的面前。"
    "Lはフォークでアワビと椎茸をすくい取り、そっと皿に移した。続いてスプーンで、煮込んで旨みを凝縮させた香り高い濃い出汁をたっぷりとかける。盛り付けを軽く整えると、その一皿を丁寧に月の前へ差し出した。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_5f20dce8:

    # "L将沾上酱汁的的餐具随意丢到了一旁，他没有凑近月解开青年手铐的意思，只是从餐车的第二层拿起新的一套餐具切割起盘内摆放整齐的食物。"
    "Lはソースで汚れた食器を横に放り出すと、月の手錠を外そうとはせず、ワゴンの二段目から新しいカトラリーを取り出した。そして皿の上に整然と盛られた料理へと刃を入れ、手際よく切り分けていく。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_25393722:

    # "餐刀向下切开鲍鱼，鲍鱼滑弹的肉质顺着L施力的方向一点点分开，将内里柔软的溏心质地展露在月的面前。"
    "Lがナイフを滑らせると、アワビの弾むような身が力に従って割れ、内側の柔らかな部分が月の前に露わになった。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_51b7324c:

    # "L简单地将鲍鱼一分为二，又从边角上切下一块沾了沾酱汁，用叉子顶住鲍鱼肉送到月的嘴边。"
    "Lはアワビを二つに割ると、端から小さく切り分けてソースをまとわせ、フォークにのせたまま月の唇の前へと差し出した。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_b1de582d:

    # "月在咬下的瞬间便感受到了鲍鱼充盈的胶质，炖煮后的鲍汁更显鲜美，浓郁的蛋白融入到汤汁后变得粘稠，"
    "月がひとかみした途端、アワビ特有のぷるりとしたゼラチン質が口いっぱいに広がった。煮込みで引き出された旨味はひときわ濃く、溶け込んだタンパク質がスープをとろりと濃厚にしていた。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_53a9d5c4:

    # "海鲜豪迈的味道迅速席卷了味蕾，筋道的肉质在咀嚼时不断回弹，进一步展现出鲍鱼独特的口感。"
    "海産物特有の豊かな味がすぐに味蕾を包み込み、歯ごたえのある肉質は噛むたびに弾力を戻し、アワビ特有の食感をさらに引き立てた。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_d5d18cb0:

    # "鲍鱼靠近中部的溏心呈现出半透明的质感，除去Q弹外还保有了些许软糯，鲜美的回味只让人食欲大开地想要吃下第二口。"
    "アワビの中心に近い部分は半透明に透け、弾む歯ごたえの中にほんのりとろけるような柔らかさを宿していた。旨みの余韻は格別で、自然ともう一口を欲してしまうほどだった。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_5aa51b0b:

    # "在咀嚼鲍鱼的时候，月瞥见了一旁被L冷落的米饭和花菇，即使是十分美味的餐点，碍于面子他还是先尝试等待L会交换食材的顺序喂食———"
    "アワビを噛みしめながら、月は横目でLに無視されているご飯と椎茸を見やった。どんなに美味しい料理でも、自ら欲しがるのは癪だった。彼は面子を保つように、Lが食材を取り換えて口に運んでくれるのをひとまず待ってみる――"

# game/script/daily_feed.rpy:836
translate japanese food_h5_969b7f0e:

    # "不过在鲍鱼只剩一半时，侦探还是没有任何动作。"
    "だがアワビが半分になっても、探偵は依然として何の動きもしなかった。"

# game/script/daily_feed.rpy:836
translate japanese food_h5_c9f98c91:

    # "月不得不出声提醒L这种浪费的行为。"
    "月は仕方なく声を出して L にこの無駄な行為を注意した。"

# game/script/daily_feed.rpy:854
translate japanese food_h5_7466e10b:

    # Y "龙崎，我需要摄取主食和蔬菜。"
    Y "竜崎、僕は主食と野菜も摂る必要がある。"

# game/script/daily_feed.rpy:855
translate japanese food_h5_8307bc08:

    # L "请安心夜神君，我没有遗忘这一点，只是我觉得按顺序来会比较顺手罢了。"
    L "安心してください、夜神くん。忘れていたわけではありません。ただ、順を追った方がやりやすいと考えただけです。"

# game/script/daily_feed.rpy:856
translate japanese food_h5_cf257434:

    # Y renzhen "用鲍汁配饭或菜是最基本的食用方法吧？还是说龙崎打算最后让我用水煮西兰花配着白饭吃么。"
    Y renzhen "アワビの出汁をご飯や野菜に絡めるのが普通の食べ方だろう？ 　まさか竜崎、締めにただの茹でブロッコリーで白飯を食べさせるつもりじゃないだろうな。"

# game/script/daily_feed.rpy:857
translate japanese food_h5_e311bf5c:

    # L surprise "我是有这个打算，夜神君有什么疑问吗？"
    L surprise "その予定です。何か問題でも？"

# game/script/daily_feed.rpy:858
translate japanese food_h5_0e5a57e1:

    # Y renzhen "当然啊！怎么会有这样的吃法啊！"
    Y renzhen "当然だ！そんな食べ方いいわけないだろう！"

# game/script/daily_feed.rpy:859
translate japanese food_h5_c7869e03:

    # L order1 "我知道了，夜神君，你先冷静一点。进食时情绪波动太大会影响消化的。"
    L order1 "わかりました、夜神くん。落ち着いてください。食事中に感情が大きく変動すると消化に影響が出ます。"

# game/script/daily_feed.rpy:860
translate japanese food_h5_5436f44c:

    # Y han "所以还不是要怪你搭配食物的手法太烂……"
    Y han "おまえの食材の組み合わせが下手なせいだろ……"

# game/script/daily_feed.rpy:862
translate japanese food_h5_dc675842:

    # "L似乎真的听进去了月的提议，他转而从餐刀切下了一块花菇，并舀起一口米饭放到餐勺里，和沾满鲍汁的花菇一块送到了月的嘴边。"
    "Lはどうやら本当に月の提案を聞き入れたようで、ナイフで椎茸を一切れ切り取り、さらにスプーンでご飯をすくい、アワビの煮汁をたっぷり含んだ椎茸と一緒に月の口元へ差し出した。"

# game/script/daily_feed.rpy:864
translate japanese food_h5_ab6f7e4f:

    # L pt "按照夜神君刚才的要求做了，现在可以继续吃了吧？"
    L pt "夜神くんの言う通りにしてみました。これで食べてくれますか？"

# game/script/daily_feed.rpy:865
translate japanese food_h5_966fae88:

    # Y pt "不要说得好像这是什么无理的要求一样。"
    Y pt "まるで理不尽なわがままみたいに言うなよ。"

# game/script/daily_feed.rpy:867
translate japanese food_h5_d9c67474:

    # "月懒得继续搭理这个奇怪的人，只是颇为安静地吃着改变了喂食顺序的餐点，"
    "月はこの変人にこれ以上言葉を返すのも面倒になり、黙って、順番が改められた料理を口に運んでいた。"

# game/script/daily_feed.rpy:867
translate japanese food_h5_0f69b4d9:

    # "两个人迅速回归到沉默的状态，囚室内一时间只有零散的咀嚼声和金属餐具碰撞碗碟的声音。"
    "やがて二人は再び沈黙に包まれ、牢獄に満ちるのは、時折響く咀嚼の音と、食器が皿に触れ合うかすかな金属音だけとなった。"

# game/script/daily_feed.rpy:871
translate japanese food_h5_c60fb755:

    # Y "很美味的一餐，多谢款待。"
    Y "美味しかった、ご馳走様。"

# game/script/daily_feed.rpy:875
translate japanese food_h5_1438ea51:

    # "L闻言停下了继续喂食的动作，关闭了卡式炉的开关，将用脏的餐具简单丢到砂锅里面盖上了锅盖，确保没有遗漏后推着餐车离开了囚室。"
    "Lはその言葉を聞くと給餌の動作を止め、カセットコンロのスイッチを切った。汚れた食器を簡単に土鍋の中へ放り込み、蓋をして確認すると、抜けがないのを確かめてからワゴンを押しながら牢獄を後にした。"

# game/script/daily_feed.rpy:881
translate japanese food_h5_6d61702b:

    # "L绕到月的后方，用钥匙插进锁孔为青年解开了手铐。月活动了下有些酸痛的肩膀，在用餐车上准备好的热毛巾擦拭双手时出声问道。"
    "Lは月の背後に回り、鍵を錠前に差し込んで青年の手錠を外した。月は少し痺れるように痛んだ肩を動かしながら、ワゴンの上に用意されていた温かいタオルで両手を拭きつつ口を開いた。"

# game/script/daily_feed.rpy:883
translate japanese food_h5_93af1a93:

    # Y "怎么今天突然有兴趣解开我的手铐了？"
    Y "なんで今日は突然手錠を外す気になったんだ？"

# game/script/daily_feed.rpy:884
translate japanese food_h5_d1ac4eed:

    # L "渡说今天的餐点需要保持加热的状态，每个人对温度的感知都是不一样的，我担心直接喂可能会烫伤夜神君的食道。"
    L "ワタリが言うには、今日の料理は温かい状態を保つ必要があるそうです。人それぞれ温度の感じ方は違いますから、私が食べさせると夜神くんの食道を火傷させてしまう恐れがあったので。"

# game/script/daily_feed.rpy:885
translate japanese food_h5_1483e059:

    # L smile3 "而且……夜神君在吃这样的料理时也更喜欢自己动手吧？"
    L smile3 "それに…… こういった料理は夜神くんも自分で食べる方を好むと思います。"

# game/script/daily_feed.rpy:886
translate japanese food_h5_9c8d3e9c:

    # Y smile1 "啊啊，没想到龙崎偶尔也能体谅我呢。"
    Y smile1 "なるほど、竜崎もたまには僕のことを配慮してくれるんだな。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_0ba6d447:

    # "月拿起被餐巾包裹好的餐具，抽出餐刀向下切开鲍鱼，鲍鱼滑弹的肉质顺着施力的方向一点点分开，将内里柔软的溏心质地展露在食客面前。"
    "月はナプキンに包まれた食器を取り上げ、ナイフでアワビに刃を入れる。ぷるりと弾む身が力に従って開き、中から柔らかな半透明の部分が姿を現した。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_c8f14651:

    # "月将鲍鱼一分为二，从边角上切下一块沾了沾酱汁，用叉子顶住鲍鱼肉送入嘴中。"
    "月はアワビを二つに分け、端から小さな一片を切り出してソースをまとわせると、フォークにのせて口へと運んだ。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_b6f4da16:

    # "月在咬下的瞬间便感受到了鲍鱼充盈的胶质，炖煮后的鲍汁更显鲜美，浓郁的蛋白融入到汤汁后变得粘稠，海鲜豪迈的味道迅速席卷了味蕾，"
    "月がひとかみした途端、アワビ特有のぷるんとしたゼラチン質が舌に広がった。煮込まれて引き出された濃厚な旨みがスープに溶け込み、とろりとした粘度を帯びながら、力強い海の風味が一気に口中を支配した。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_ab3230b4:

    # "筋道的肉质在咀嚼时不断回弹，进一步展现出鲍鱼独特的口感。"
    "歯ごたえのある肉質は噛むたびに弾力を戻し、アワビ特有の食感をさらに引き立てた。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_d5d18cb0_1:

    # "鲍鱼靠近中部的溏心呈现出半透明的质感，除去Q弹外还保有了些许软糯，鲜美的回味只让人食欲大开地想要吃下第二口。"
    "アワビの中央寄りの半生部分は半透明の質感を呈し、弾力性のほかに少しの柔らかさも持ち、旨味の余韻が食欲を掻き立てて次の一口を食べたくさせた。"

# game/script/daily_feed.rpy:888
translate japanese food_h5_abad9ca7:

    # "L在月吞下鲍鱼的溏心时开口补充了一些知识，为这段美味的餐食增添了些许乐趣。"
    "月がアワビの半熟の部分を飲み込んだとき、Lは口を開いていくつかの知識を補足し、この美味なる食事に少しばかりの楽しみを添えた。"

# game/script/daily_feed.rpy:900
translate japanese food_h5_385675fd:

    # L "夜神君今天吃的是新宿OOOO酒店中餐厅的干鲍，订餐时主厨特别推荐了日本的两头鲍，"
    L "夜神くんが食べているのは、新宿の有名ホテルの中華レストランの干しアワビです。注文の際、料理長が日本産の二頭のアワビを勧めてきました。"

# game/script/daily_feed.rpy:900
translate japanese food_h5_26c45b1b:

    # L "特点就是在鲍鱼原有滑弹口感的同时能保留中心的黏度，不知道是否合夜神君的胃口呢。"
    L "このアワビは、もっちりとした弾力を残しつつ中心にはとろみがあるのが特徴です。夜神くんの口に合うかは分かりませんが。"

# game/script/daily_feed.rpy:903
translate japanese food_h5_cb6ba379:

    # L smile1 "夜神君喜欢的话，之后也可以去餐厅就餐哦。"
    L smile1 "夜神くんが気に入ったのであれば、今後はレストランに行って食事をすることもできます。"

# game/script/daily_feed.rpy:904
translate japanese food_h5_caeb3db1:

    # Y smile2 "龙崎，这是约会的邀请吗？"
    Y smile2 "竜崎、それはデートの誘いか？"

# game/script/daily_feed.rpy:905
translate japanese food_h5_4e91d0ac:

    # L smile3 "如果夜神君表现好的话，是的。"
    L smile3 "夜神くんがこちらに対して友好的に振舞うのでしたら、そうですね。"

# game/script/daily_feed.rpy:906
translate japanese food_h5_ca4312ba:

    # Y "那还真是多谢了，我也很想出去放放风，囚室里的空气简直让人快吐出来了。"
    Y "そうか……。僕も、外に出て気分を変えたい。独房の空気は息が詰まる。"

# game/script/daily_feed.rpy:908
translate japanese food_h5_1156ae05:

    # "月低下头，许久未修剪的头发遮住了他的眼睛，让L有些看不清月的表情。"
    "月はうつむき、長い間整えられていない髪がその目を覆い隠したため、Lには月の表情が少し見えにくくなった。"

# game/script/daily_feed.rpy:908
translate japanese food_h5_47d5195e:

    # "月用餐刀切下了一块花菇，并舀起一口米饭放到餐勺里，和沾满鲍汁的花菇一块吃了下去。"
    "月はナイフで椎茸を一切れ切り取り、さらにスプーンでご飯をすくい、アワビの煮汁をたっぷり吸った椎茸と一緒に口へ運んで食べた。"

# game/script/daily_feed.rpy:908
translate japanese food_h5_4195771e:

    # "餐点很快在月井然有序的分配下被一扫而空，月简单将餐具摆到瓷盘上，抬头对L说道。"
    "月の几帳面な手で順序よく取り分けられた料理は、すぐにきれいに平らげられた。食器を皿の上にまとめて置くと、月は顔を上げてLに声をかけた。"

# game/script/daily_feed.rpy:914
translate japanese food_h5_c8f02e05:

    # Y smile1 "很美味的餐点，龙崎，多谢款待。"
    Y smile1 "美味しい食事だった、竜崎。ご馳走様。"

# game/script/daily_feed.rpy:916
translate japanese food_h5_27706e41:

    # "L关闭了卡式炉的开关，整理起月用脏的餐具，在仔细清点、确保没有遗漏后重新为月戴上手铐，推着餐车离开了囚室。"
    "Lはその言葉を聞くと給餌の動作を止め、カセットコンロのスイッチを切った。汚れた食器を簡単に土鍋の中へ放り込み、蓋をして確認すると、抜けがないのを確かめてからワゴンを押しながら牢獄を後にした。"

# game/script/daily_feed.rpy:916
translate japanese food_h5_f6665d31:

    # "在他快要合上囚室门的那一刻，原本垂着脑袋的青年突然出声叫住了他。"
    "牢獄の檻を閉めかけた時、頭を下げていた月が突然声を出してLを呼び止めた。"

# game/script/daily_feed.rpy:920
translate japanese food_h5_59c9dc7e:

    # Y pt "龙崎。"
    Y pt "竜崎。"

# game/script/daily_feed.rpy:921
translate japanese food_h5_416e7b13:

    # L surprise "是，夜神君，还有什么事吗？"
    L surprise "はい、夜神くん。何か用ですか？"

# game/script/daily_feed.rpy:922
translate japanese food_h5_31f02216:

    # Y smile1 "我很期待和龙崎一起去新宿的那天。"
    Y smile1 "竜崎と一緒に新宿に行く日を楽しみにしている。"

# game/script/daily_feed.rpy:923
translate japanese food_h5_55e77995:

    # Y "那么，明天再见。"
    Y "では、明日また。"

# game/script/daily_feed.rpy:925
translate japanese food_h5_b46133e9:

    # "L有些诧异地看着月，青年倒是很快背过身去结束了对话。"
    "L は少し驚いた表情で月を見つめたが、青年はすぐに背を向けて会話を終えた。"

# game/script/daily_feed.rpy:925
translate japanese food_h5_982cf5f6:

    # "直到囚室的铁门关闭时冒出吱呀一声，L才意识到或许他该乘坐电梯离开了。"
    "牢獄の鉄扉がきしむ音を立てて閉まったその瞬間、Lはようやく自分がエレベーターで立ち去るべきだったことに気づいた。"

# game/script/daily_feed.rpy:925
translate japanese food_h5_053ecfd1:

    # "想和夜神君再聊几句别的。L想道。"
    "夜神くんともう少し話をしたいと L は思った。"

# game/script/daily_feed.rpy:925
translate japanese food_h5_27e475fe:

    # "不过，自己和夜神君还有很长的时间呢，一切都来日方长。"
    "だが、自分と月にはまだ長い時間があるのだ。すべてはこれからゆっくり進めていけばいい。"

# game/script/daily_feed.rpy:941
translate japanese food_p1_ce3bc870:

    # "L拿来了照烧鸡肉饭团和味增汤。"
    "Lは照り焼きチキンのおにぎりと味噌汁を持ってきた。"

# game/script/daily_feed.rpy:941
translate japanese food_p1_872b2305:

    # "月看见正常的食物有些诧异。"
    "月は目の前に並んだまともな食事に、少し驚く。"

# game/script/daily_feed.rpy:945
translate japanese food_p1_99c5a90a:

    # Y smile2 "L大人怎么舍得给我吃这种食物了？"
    Y smile2 "L 様はどうして僕にこんなまともな食事を与えてくれるんだ？"

# game/script/daily_feed.rpy:947
translate japanese food_p1_9b4fcd17:

    # L "……"
    L "……"

# game/script/daily_feed.rpy:954
translate japanese food_p1_6fe5c1e4:

    # L "如果觉得过于豪华了，那我就端回去了。"
    L "もし豪華すぎると感じられるのであれば、持ち帰ります。"

# game/script/daily_feed.rpy:956
translate japanese food_p1_429e5c05:

    # "夜神月的脸色变得更加难看了。"
    "夜神月の顔色はさらに悪くなった。"

# game/script/daily_feed.rpy:958
translate japanese food_p1_9f683442:

    # Y Light "既然是L大人的恩典就不得不领情了吧，还是说你只是想用这种低级手段折磨我？"
    Y Light "L様の施しとあればありがたく頂くしかないだろう。それとも、こんな安っぽいやり方で僕を苦しめたいだけか？"

# game/script/daily_feed.rpy:963
translate japanese food_p1_e8dd3b2f:

    # "月的唇边有着明显的的讽笑。"
    "月の口元にははっきりとした嘲笑が浮かんだ。"

# game/script/daily_feed.rpy:963
translate japanese food_p1_f8c602ad:

    # "L把饭团递到月的嘴边，月咬牙切齿地吃了。"
    "L がおにぎりを月の口元に差し出すと、月は歯ぎしりをしながらそれを食べる。"

# game/script/daily_feed.rpy:963
translate japanese food_p1_9f2b6fb1:

    # "L端着空的餐盘走出了囚室。"
    "L は空のトレイを持って牢獄から出ていった。"

# game/script/daily_feed.rpy:976
translate japanese food_p1_fa37d778:

    # L "的确算是少见的一餐呢，夜神君不需要吗。"
    L "確かに珍しい食事ですが……夜神くん、いらないんですか？"

# game/script/daily_feed.rpy:978
translate japanese food_p1_d7a305b9:

    # Y smile2 "不，是人就需要吃饭吧，我得感谢你的人道主义呢。"
    Y smile2 "いや、人間なら誰でも食べる必要がある。おまえの人道主義に感謝するよ。"

# game/script/daily_feed.rpy:980
translate japanese food_p1_99b2a4d0:

    # "月的唇边有着若有若无的讽笑。"
    "月の唇には、かすかに嘲るような笑みが浮かんでいた。"

# game/script/daily_feed.rpy:980
translate japanese food_p1_d175de97:

    # "L把饭团递到月的嘴边，对方这次倒是配合地吃了。"
    "Lがおにぎりを差し出すと、月は今度は抵抗せずにおとなしく口にした。"

# game/script/daily_feed.rpy:980
translate japanese food_p1_9f2b6fb1_1:

    # "L端着空的餐盘走出了囚室。"
    "L は空のトレイを持って牢獄から出ていった。"

# game/script/daily_feed.rpy:993
translate japanese food_p2_cbe32103:

    # "L端来了一份咖喱盖浇饭"
    "L はカレー丼を持ってきた。"

# game/script/daily_feed.rpy:995
translate japanese food_p2_98dd0268:

    # L "夜神君，饿了吗？"
    L "夜神くん、お腹が空きましたか？"

# game/script/daily_feed.rpy:997
translate japanese food_p2_36e2052e:

    # Y "我不想吃饭。"
    Y "食べたくない。"

# game/script/daily_feed.rpy:1007
translate japanese food_p2_c9ccbcaa:

    # L "可是夜神君距离上次进食已经间隔了6个小时了，你现在应该进食才能保证你的身体健康。"
    L "しかし夜神くん、前回の食事から 6 時間経過しています。食事をしないと健康を保てません。"

# game/script/daily_feed.rpy:1009
translate japanese food_p2_ab65e388:

    # Y jiaoji1 "我说了我现在不想吃饭！"
    Y jiaoji1 "僕は今食べたくないって言っただろ！"

# game/script/daily_feed.rpy:1011
translate japanese food_p2_b8ce09ee:

    # L "如果夜神君改变主意了可以叫我，我随时可以收到讯息。"
    L "そうですか、夜神くんの気が変わったら呼んでください。いつでも連絡を待っています。"

# game/script/daily_feed.rpy:1013
translate japanese food_p2_4314420a:

    # "L离开了。月依然坐在床上。"
    "Lが部屋を後にしても、月はただ黙ってベッドに腰掛け続けていた。"

# game/script/daily_feed.rpy:1013
translate japanese food_p2_528eff0b:

    # "到了晚上，L重新打开了月囚室的门，看见褐发青年正躺在床上，好像是睡着了。"
    "夜になると、L は再び月の牢獄の檻を開けた。月はベッドに横たわり、眠っているように見える。"

# game/script/daily_feed.rpy:1013
translate japanese food_p2_84af6cdd:

    # "L拍了拍月的肩膀，青年发出一声鼻音，悠悠转醒，坐了起来。"
    "Lに肩を叩かれた月は、ふっと鼻を鳴らして目を覚まし、ゆるやかに身を起こした。"

# game/script/daily_feed.rpy:1019
translate japanese food_p2_369f8700:

    # L "夜神君，距离你上次进食已经过了12个小时了，如果你再不吃饭我要采取强制措施了哦。"
    L "夜神くん、前回の食事から 12 時間経過しています。もし今すぐ食事をしない場合、強制的な措置を取ることになります。"

# game/script/daily_feed.rpy:1021
