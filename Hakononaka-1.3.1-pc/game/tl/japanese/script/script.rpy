# game/script/script.rpy:389
translate japanese start_1199b306:

    # mb "以上，接下来请享受本作吧。"
    mb "以上、それでは本作をお楽しみください。"

# game/script/script.rpy:433
translate japanese start_c2cf5fe8:

    # pb "“到底是怎么回事？为什么不公开Kira的身份？！”"
    pb "「一体どういうことだ？なぜキラの正体を公開しない？！」"

# game/script/script.rpy:434
translate japanese start_fc95f409:

    # pb "“让我们直接和L对话，交涉人！”"
    pb "「我々にLと直接話しをさせろ、交渉人！」"

# game/script/script.rpy:435
translate japanese start_7e1e5630:

    # pb "“你说Kira已经被秘密处刑了，这是怎么回事？”"
    pb "「キラはすでに極秘処刑されたと言うが、これはどういうことだ？」"

# game/script/script.rpy:436
translate japanese start_0ebe624b:

    # pb "会场里在交涉人宣布Kira已经被L秘密处刑之后，掀起了轩然大波。"
    pb "会場では、交渉人がキラはすでにLによって極秘処刑されたと発表した後、大きな騒ぎが巻き起こった。"

# game/script/script.rpy:437
translate japanese start_5f84bbb2:

    # pb "各国的警方如同八卦记者一样，恨不得从座位上跳起来扑向渡，把话筒递到渡的嘴边。"
    pb "各国の警察官たちは、ゴシップ記者のように、席から飛び起きてワタリに駆け寄り、マイクを彼の口元に突きつける勢いだった。"

# game/script/script.rpy:439
translate japanese start_9a86a118:

    # D 2 "请肃静，现在就让大家听听L的声音。"
    D 2 "お静かにお願いします、Lの声を今お聞かせ致します。"

# game/script/script.rpy:446
translate japanese start_2443a78d:

    # pb "话筒一阵刺耳的高音过后，会场恢复了安静，警官们窃窃私语着，猜测交涉人会给出什么回答。"
    pb "マイクから耳障りな高音が響いた後、会場は再び静けさを取り戻した。警官たちはひそひそと囁き合い、交渉人がどんな答えを出すのかを推測していた。"

# game/script/script.rpy:454
translate japanese start_84f2c666:

    # pb "渡打开一台银白色的笔记本电脑，L哥特字母的图案出现在电脑屏幕和会场的大荧幕之上，L独特的电子音也随之响起。"
    pb "ワタリが銀色のノートPCを開くと、パソコンの画面と会場の巨大スクリーンに「L」の文字が映し出された。しばらくして、Lの特有の電子音声が響き渡った。"

# game/script/script.rpy:456
translate japanese start_af33257d:

    # L laptop "ICPO的各位，我是L。"
    L laptop "ICPOの皆様、Lです。"

# game/script/script.rpy:458
translate japanese start_4710b9d9:

    # L laptop "在各位屈服于Kira的杀人能力的时候，是我带领人员秘密调查，找到了真凶。"
    L laptop "皆様がキラの殺人能力に屈していた時、私は人員を率いて極秘捜査を行い、キラである真犯人を見つけ出しました。"

# game/script/script.rpy:458
translate japanese start_e19e0266:

    # L laptop "当Kira落网之后，各位又开始心思活跃，开始想要利用Kira的杀人能力了吗？"
    L laptop "キラが捕まった途端、あなた方はキラの殺人能力を利用しようと考え始めたのではありませんか？"

# game/script/script.rpy:458
translate japanese start_006658f8:

    # L laptop "恕我直言，这简直是卑鄙无耻的行为。"
    L laptop "率直に言わせていただくと、それは実に卑劣な行為です。"

# game/script/script.rpy:458
translate japanese start_bc6a09b1:

    # L laptop "Kira的杀人能力已经被我封印，真凶落网之后，也不会再有同样的事件发生，我以L的名义保证。"
    L laptop "キラの殺人能力は既に私によって封じられ、真犯人が逮捕された今、同様の事件は二度と起こらないことをLの名において保障します。"

# game/script/script.rpy:458
translate japanese start_c1cf8adc:

    # L laptop "以上，谢谢聆听。"
    L laptop "以上、ご清聴ありがとうございました。"

# game/script/script.rpy:472
translate japanese start_e5d69531:

    # pb "语音通话被挂断了，渡干脆利落地合上电脑，在众人反应过来之前从后门离开了。"
    pb "音声通話が切断されると、ワタリはためらうことなくノートパソコンを閉じ、人々が反応する前に裏口から立ち去った。"

# game/script/script.rpy:479
translate japanese start_3f330828:

    # pb "被关在身后的，是一片哗然的会场，充斥着对L狂妄言论的声讨，渡对此的反应只是扶正了有些歪斜的礼帽。"
    pb "背後の会場では、Lの傲慢な発言に対する非難が満ち溢れ、場内は騒然としていた。だが、ワタリが示した反応といえば、わずかに傾いたシルクハットを直すだけだった。"

# game/script/script.rpy:480
translate japanese start_d435dd2f:

    # pb "L本人早已预料到了这种情况，所谓的语音通话只是提前准备好的录音，"
    pb "L本人はこの状況を予想していた。あの音声通話と称されたものも、実際は事前に仕込んでおいた録音だった。"

# game/script/script.rpy:480
translate japanese start_858ba5ce:

    # pb "他这次来并不是为了解释什么，或者和警方们谈心，只是在通知罢了。"
    pb "彼がわざわざ来たのは、説明するためでも警察と腹を割って話すためでもない。ただ一方的に告げに来ただけだった。"

# game/script/script.rpy:483
translate japanese start_3e085a18:

    # pb "本尊早就将此事抛之脑后，划定为已完成的事项，不再关心。"
    pb "Lはすでにこの件を忘れ去り、完了した事柄として区分し、もはや気にかけていなかった。"

# game/script/script.rpy:484
translate japanese start_4c0875be:

    # pb "因为他现在，有更加关注的事情。"
    pb "なぜなら、今のLには、より注目していることがあった。"

# game/script/script.rpy:497
translate japanese start_d930593a:

    # pb "蹲坐在舒服的皮质沙发椅上，海绵和弹簧提供恰到好处的支撑力，宽大的座椅让整个人团在里面也不会觉得狭窄。"
    pb "心地よい革張りのソファに身を沈める。弾力のあるクッションとスプリングが絶妙な支えとなり、ゆったりとした座面は身体を丸めても窮屈さを感じさせない。"

# game/script/script.rpy:498
translate japanese start_2dcbbdf1:

    # pb "口味浓郁的香草奶油冰激凌被装在造型精美的镭射玻璃高脚杯里，上面淋了一层巧克力，"
    pb "濃厚なバニラアイスは、精巧なデザインのガラス製の器に盛り付けられ、上からチョコレートがかけられていた。"

# game/script/script.rpy:498
translate japanese start_bd1cdf0a:

    # pb "上面本应点缀的车厘子已经被吃掉了，一柄银质餐匙斜靠在杯壁上，匙面上还有未吮干净的奶油。"
    pb "本来であれば飾られるべきチェリーはすでに食べられており、銀製のデザートスプーンが器の壁に寄りかかっていて、スプーンの表面にはまだ舐めきられていないクリームが残っていた。"

# game/script/script.rpy:502
translate japanese start_ccac016f:

    # L icecream1 "已经结束了吗？辛苦你了，渡。"
    L icecream1 "もう終わりましたか？お疲れさまでした、ワタリ。"

# game/script/script.rpy:503
translate japanese start_c34b21ad:

    # D "引起了相当大的骚动呢，不知道之后会持续多久。"
    D "相当な騒動を引き起こしましたね。これからどれくらい続くかわかりませんが。"

# game/script/script.rpy:504
translate japanese start_4067c7a1:

    # L icecream1 "既定事实确定之后，公众很快就会把注意力转移到别的事情上的。"
    L icecream1 "既成事実が確定すれば、大衆はすぐに注意をほかの事柄へと移すものです。"

# game/script/script.rpy:505
translate japanese start_9a1c558b:

    # pb "老人在话筒对面叹了口气，L感受到对方的担忧之情，但只是抿着嘴，固执地不愿意说更多。"
    pb "老人がマイクの向こうでため息をつく。Lはワタリの心配の情を感じ取ったが、口を結び、これ以上は頑なに話そうとはしなかった。"

# game/script/script.rpy:506
translate japanese start_a1658ae8:

    # L icecream1 "渡，快回来吧。"
    L icecream1 "ワタリ、早く戻ってください。"

# game/script/script.rpy:508
translate japanese start_b70d854b:

    # pb "切断通讯后，L的视线落在屏幕上的一点，失去了焦距，难得发了会呆。"
    pb "通信を切ったあと、Lは画面の一点を見つめたまま焦点を失い、珍しくしばし呆然としていた。"

# game/script/script.rpy:508
translate japanese start_a9ce5915:

    # pb "……无论如何，已经做下的事情，不会改变。"
    pb "……いずれにせよ、すでに行ってしまったことは、変えられない。"

# game/script/script.rpy:508
translate japanese start_26630817:

    # pb "他不是会为打翻的牛奶惋惜的人。"
    pb "Lはこぼしたミルクを惜しむような人間ではなかった。"

# game/script/script.rpy:508
translate japanese start_1dcafa22:

    # pb "视线重新聚焦，落在了一处监控屏幕上。"
    pb "視線が再び焦点を結び、一つの監視モニター画面に落ちる。"

# game/script/script.rpy:508
translate japanese start_61da5a3e:

    # pb "那屏幕里铁黑的栏杆排列，明显是一间牢房。"
    pb "スクリーンに映し出されたのは、黒色の格子が規則正しく並ぶ光景、明らかに牢屋の一室だった。"

# game/script/script.rpy:508
translate japanese start_9e065d19:

    # pb "而在牢房之中，正关押着一名青年。"
    pb "そしてその牢屋の中には、一人の青年が閉じ込められていた。"

# game/script/script.rpy:508
translate japanese start_9ab28dbb:

    # pb "一名有着褐色柔顺头发，年纪不大，身材匀称的青年。"
    pb "褐色の柔らかな髪をした、均整のとれた体格の青年。"

# game/script/script.rpy:508
translate japanese start_ad7f425f:

    # pb "他正穿着纯黑的囚服，双手被反铐在身后，双脚也被紧缚，低着头，从监控摄像头里看不清他的表情。"
    pb "彼は黒の囚人服を着ており、両手は背後で手錠にかけられ、両足も固く縛られていた。頭を垂れていて、監視カメラ越しにはその表情を確認することができなかった。"

# game/script/script.rpy:508
translate japanese start_98f19dfd:

    # pb "如果是不知情的旁人看见，估计会好奇，这青年犯了什么罪，需要被这样严苛地对待？"
    pb "もし事情を知らない第三者が見たのであれば、この青年はどんな罪を犯したのだろうか、これほど厳格に扱われる必要があるのかと訝しむだろう。"

# game/script/script.rpy:508
translate japanese start_1f36fe00:

    # pb "这时候如果告诉这人，这位就是大名鼎鼎的Kira，估计会被吓一跳吧。"
    pb "もしも、彼こそがあのキラの正体だと伝えたならば、誰もが驚くだろう。"

# game/script/script.rpy:508
translate japanese start_37fd79ea:

    # pb "完全无法想象，这名看起来年轻优秀的青年会是以一己之力恐吓威慑全世界罪犯的传奇杀人犯。"
    pb "想像できるわけがない。この若く優秀に見える青年が、たった一人で世界中の犯罪者を震え上がらせた伝説の殺人犯だなんて。"

# game/script/script.rpy:508
translate japanese start_ece993b7:

    # pb "夜神月……L在心里默念着这名青年的名字。"
    pb "「夜神月……」Lは心の中で、青年の名前をそっと唱えた。"

# game/script/script.rpy:508
translate japanese start_d6874b6a:

    # pb "私心亦或是私刑，这的的确确是他做的事情。"
    pb "私心であれ私刑であれ、それは確かに彼が行ったことだった。"

# game/script/script.rpy:508
translate japanese start_1f6389e1:

    # pb "愚弄了全世界，将Kira关在了自己的秘密牢房内。"
    pb "全世界を愚弄し、キラを自分の極秘牢獄に閉じ込めた。"

# game/script/script.rpy:508
translate japanese start_3752216c:

    # pb "为了保持夜神月身为Kira的记忆，将死亡笔记的纸片植入了对方的后颈皮肤。"
    pb "夜神月にキラとしての記憶を保持させるため、デスノートの紙片を彼の首の後ろの皮膚に埋め込んだ。"

# game/script/script.rpy:508
translate japanese start_08214152:

    # pb "消去对方的真实身份，无论做了什么都不会被世人发现。"
    pb "相手の正体を消し去り、何をしようとも世間に知られることはない。"

# game/script/script.rpy:508
translate japanese start_1deb0c75:

    # pb "此处，是他所搭建的{color=#0000ff}箱庭世界{/color}。"
    pb "ここは、彼が築いた{color=#0000ff}箱庭の世界{/color}だった。"

# game/script/script.rpy:551
translate japanese start_849d875f:

    # "曾持有世界上最恐怖的杀人凶器的罪犯被关押在这里，即使世人皆以为他已经死去。"
    "かつて世界で最も恐ろしい殺人の凶器を所持していた犯罪者がここに収監されている。世間が彼はすでに死んだと思い込んでいても。"

# game/script/script.rpy:552
translate japanese start_9919f1b8:

    # "褐发青年被戴上镣铐，不过他依然表现得相当平静。"
    "褐色の髪の青年は足枷をはめられていたが、それでも相当落ち着いた様子を見せていた。"

# game/script/script.rpy:553
translate japanese start_21bcde4a:

    # sy "今天是监禁的第 [day] 天。"
    sy "本日は監禁してから[day]日目です。"

# game/script/script.rpy:554
translate japanese start_2aaf9f80:

    # sy "现在有 [action_points] 个行动点数。"
    sy "現在の行動ポイントは [action_points] です。"

# game/script/script.rpy:555
translate japanese start_c8cd1c06:

    # sy "接下来可以行动了。"
    sy "これから行動ができます。"

# game/script/script.rpy:557
translate japanese start_d5ad15ef:

    # sy "需要查看新手教程吗？" nointeract
    sy "チュートリアルの確認は必要ですか？" nointeract

# game/script/script.rpy:559
translate japanese start_d1d49785:

    # sy "本游戏为试玩版，在本游戏中，你可以用L的视角在7天内对监禁中的夜神月采取任意行动。"
    sy "本ゲームは体験版です。本ゲームでは、7日間という期間内で、Lの視点を通じて監禁中の夜神月に対し、任意の行動を取ることができます。"

# game/script/script.rpy:559
translate japanese start_4d5aa011:

    # sy "每天有4个行动点数，行动点数耗尽后进入下一天。"
    sy "1日の行動ポイントは4です。行動ポイントを全て消費すると自動的に翌日へ移行します。"

# game/script/script.rpy:559
translate japanese start_6e996751:

    # sy "注意，做爱会消耗2点行动点数。"
    sy "セックスでは2ポイント消費します。注意してください。"

# game/script/script.rpy:559
translate japanese start_e0de52f1:

    # sy "采取不同的行动，夜神月的状态也会发生改变。温柔地对待亦或是冷酷地折磨？由你来决定。"
